
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "~/Views/Shared/_LayoutSeguridad.cshtml";

    string? token = ViewBag.Token as string;
    string? error = ViewBag.Error as string;
}

<div class="restablecer-page">

    <div class="restablecer-card">

        <!-- LOGO -->
        <div class="restablecer-logo">
            <div class="restablecer-logo-icon">
                <i class="bi bi-scissors"></i>
            </div>

            <h1>YAMPI</h1>
            <span>BARBER SHOP</span>
        </div>

        <div class="restablecer-divider"></div>

        <!-- ENCABEZADO -->
        <div class="restablecer-header">
            <div class="restablecer-header-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h2>Restablecer contraseña</h2>

            <p>
                Ingresa tu nueva contraseña para
                recuperar el acceso a tu cuenta.
            </p>
        </div>

        <!-- ERRORES -->
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="restablecer-alert" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span>@error</span>
            </div>
        }

        <!-- FORMULARIO -->
        @if (!string.IsNullOrWhiteSpace(token))
        {
            <form asp-controller="Seguridad"
                  asp-action="Restablecer"
                  method="post"
                  class="restablecer-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="token"
                       value="@token" />

                <div class="restablecer-field">

                    <label for="nuevaContrasena">
                        Nueva contraseña
                    </label>

                    <div class="restablecer-input-group">
                        <i class="bi bi-lock"></i>

                        <input type="password"
                               id="nuevaContrasena"
                               name="nuevaContrasena"
                               placeholder="Ingresa tu contraseña"
                               minlength="8"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="restablecer-eye"
                                data-toggle-password="nuevaContrasena"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                </div>

                <div class="restablecer-field">

                    <label for="confirmarContrasena">
                        Confirmar contraseña
                    </label>

                    <div class="restablecer-input-group">
                        <i class="bi bi-lock-fill"></i>

                        <input type="password"
                               id="confirmarContrasena"
                               name="confirmarContrasena"
                               placeholder="Repite tu contraseña"
                               minlength="8"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="restablecer-eye"
                                data-toggle-password="confirmarContrasena"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                </div>

                <div class="restablecer-info">
                    <i class="bi bi-info-circle"></i>
                    <span>
                        Tu contraseña debe contener
                        al menos 8 caracteres.
                    </span>
                </div>

                <button type="submit"
                        class="restablecer-submit">

                    <i class="bi bi-check-circle"></i>
                    Guardar nueva contraseña

                </button>

            </form>
        }

        <!-- VOLVER -->
        <div class="restablecer-bottom">

            <a asp-controller="Seguridad"
               asp-action="Index">

                <i class="bi bi-arrow-left"></i>
                Volver al inicio de sesión

            </a>

        </div>

        <div class="restablecer-footer">
            <span>Tu estilo, nuestra pasión</span>
        </div>

    </div>

</div>
