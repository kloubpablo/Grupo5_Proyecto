@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "~/Views/Shared/_LayoutSeguridad.cshtml";
    string? token = ViewBag.Token as string;
    string? error = ViewBag.Error as string;
}

<div class="container d-flex align-items-center justify-content-center py-5"
     style="min-height:100vh">
    <div class="w-100 p-4 p-md-5"
         style="max-width:460px;background:#171719;border:1px solid #29292d;border-radius:18px">
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock" style="font-size:2.5rem;color:#d4af37"></i>
            <h2 class="mt-3 text-white">Nueva contraseña</h2>
            <p style="color:#a5a5aa">Establece una contraseña nueva para tu cuenta.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(token))
        {
            <form asp-controller="Seguridad" asp-action="Restablecer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@token" />

                <div class="mb-3">
                    <label class="form-label text-white" for="nuevaContrasena">Nueva contraseña</label>
                    <input class="form-control" type="password" id="nuevaContrasena"
                           name="nuevaContrasena" autocomplete="new-password" minlength="8" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-white" for="confirmarContrasena">Confirmar contraseña</label>
                    <input class="form-control" type="password" id="confirmarContrasena"
                           name="confirmarContrasena" autocomplete="new-password" minlength="8" required />
                </div>

                <button type="submit" class="btn w-100 fw-semibold"
                        style="background:#d4af37;color:#09090a">
                    <i class="bi bi-check-circle me-2"></i>Guardar contraseña
                </button>
            </form>
        }

        <div class="text-center mt-4">
            <a asp-controller="Seguridad" asp-action="Index"
               style="color:#d4af37;text-decoration:none">
                <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
            </a>
        </div>
    </div>
</div>
