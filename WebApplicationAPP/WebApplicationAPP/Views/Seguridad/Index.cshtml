@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LayoutSeguridad.cshtml";
}



<section class="seg-page" aria-labelledby="segTitulo">
    <div class="seg-shell">
        @await Html.PartialAsync("_SeguridadPresentacion")

        <div class="seg-form-panel">
            <div class="seg-form-inner">
                <header class="seg-heading">
                    <div class="seg-heading-icon" aria-hidden="true"><i class="bi bi-box-arrow-in-right"></i></div>
                    <span class="seg-kicker">ACCESO A TU CUENTA</span>
                    <h1 id="segTitulo">Bienvenido de nuevo</h1>
                    <p>Ingresa tus datos para administrar tus próximas citas.</p>
                </header>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="seg-alert seg-alert-success" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        <span>@TempData["Mensaje"]</span>
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="seg-alert seg-alert-error" role="alert">
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-controller="Seguridad" asp-action="Index" method="post" asp-antiforgery="true" class="seg-form">
                    <div class="seg-field">
                        <label for="segUsuario">Nombre de usuario</label>
                        <div class="seg-input-wrap">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <input id="segUsuario" name="usuario" type="text" autocomplete="username"
                                   placeholder="Escribe tu usuario" maxlength="100" required autofocus />
                        </div>
                    </div>
                    <div class="seg-field">
                        <div class="seg-label-row">
                            <label for="segPassword">Contraseña</label>
                            <a asp-controller="Seguridad" asp-action="Recuperar" class="seg-small-link">¿La olvidaste?</a>
                        </div>
                        <div class="seg-input-wrap seg-password-wrap">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input id="segPassword" name="password" type="password" autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" required />
                            <button class="seg-show-password" type="button" data-toggle-password="segPassword"
                                    aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="seg-submit">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        <span class="seg-submit-copy">Iniciar sesión</span>
                        <i class="bi bi-arrow-right seg-submit-arrow" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="seg-form-bottom">
                    <p>¿Todavía no tienes una cuenta? <a asp-controller="Seguridad" asp-action="Registrar">Regístrate aquí</a></p>
                    <a class="seg-home-link" asp-controller="YampiBarberShop" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</section>
