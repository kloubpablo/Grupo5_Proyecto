@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutSeguridad.cshtml";
}

<link rel="stylesheet" href="~/css/seguridad.css" asp-append-version="true" />

<section class="seg-page" aria-labelledby="segTitulo">
    <div class="seg-shell">
        @await Html.PartialAsync("_SeguridadPresentacion")

        <div class="seg-form-panel">
            <div class="seg-form-inner">
                <header class="seg-heading">
                    <div class="seg-heading-icon" aria-hidden="true"><i class="bi bi-envelope-check"></i></div>
                    <span class="seg-kicker">RECUPERACIÓN DE ACCESO</span>
                    <h1 id="segTitulo">Recupera tu cuenta</h1>
                    <p>Ingresa el correo asociado a tu cuenta para recibir las instrucciones de recuperación.</p>
                </header>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="seg-alert seg-alert-success" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        <span>@ViewBag.Mensaje</span>
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="seg-alert seg-alert-error" role="alert">
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-controller="Seguridad" asp-action="Recuperar" method="post" asp-antiforgery="true" class="seg-form">
                    <div class="seg-field">
                        <label for="segCorreo">Correo electrónico</label>
                        <div class="seg-input-wrap">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <input id="segCorreo" name="correo" type="email" autocomplete="email" maxlength="254"
                                   placeholder="correo@ejemplo.com" required autofocus />
                        </div>
                    </div>
                    <button type="submit" class="seg-submit">
                        <i class="bi bi-send" aria-hidden="true"></i>
                        <span class="seg-submit-copy">Recuperar acceso</span>
                        <i class="bi bi-arrow-right seg-submit-arrow" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="seg-form-bottom">
                    <a class="seg-home-link" asp-controller="Seguridad" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a iniciar sesión</a>
                </div>
            </div>
        </div>
    </div>
</section>
