@model List<WebApplicationAPP.Models.Cita>

@{

    ViewData["Title"] = "Citas";
    bool esAdministrador = ViewBag.EsAdministrador is bool && (bool)ViewBag.EsAdministrador;
    bool esCliente = ViewBag.EsCliente is bool && (bool)ViewBag.EsCliente;
    bool esBarbero = ViewBag.EsBarbero is bool && (bool)ViewBag.EsBarbero;
    bool puedeCrear = ViewBag.PuedeCrear is bool && (bool)ViewBag.PuedeCrear;
    bool puedeHorarios = ViewBag.PuedeHorarios is bool && (bool)ViewBag.PuedeHorarios;
    bool puedeMisCitas = ViewBag.PuedeMisCitas is bool && (bool)ViewBag.PuedeMisCitas;
    bool puedeEditar = ViewBag.PuedeEditar is bool && (bool)ViewBag.PuedeEditar;
    bool puedeCancelar = ViewBag.PuedeCancelar is bool && (bool)ViewBag.PuedeCancelar;
    bool puedeRecibir = ViewBag.PuedeRecibir is bool && (bool)ViewBag.PuedeRecibir;

    var horarios = ViewBag.Horarios as List<WebApplicationAPP.Models.Cita>;

    var citaEditar = ViewBag.CitaEditar as WebApplicationAPP.Models.Cita;

    bool mostrarResultadoHorarios = ViewBag.FechaHorarios != null;

    bool mostrarMensaje = TempData["MensajeCita"] != null;

    bool mostrarError = TempData["ErrorCita"] != null;

    var citasActivas = Model

        .Where(c => c.Estado == "Activa")

        .OrderBy(c => c.Fecha)

        .ThenBy(c => c.Hora)

        .ToList();

    var citasHistorial = Model

        .Where(c => c.Estado == "Cancelada" || c.Estado == "Bloqueada" || c.Estado == "Finalizada")

        .OrderByDescending(c => c.Fecha)

        .ThenByDescending(c => c.Hora)

        .ToList();

}

<link rel="stylesheet" href="~/css/citas.css" />
<link rel="stylesheet" href="~/css/clientes-buscador.css" asp-append-version="true" />

<div class="citas-page">

    <!-- =========================

         HEADER

    ========================== -->

    <section class="page-header">

        <div>

            <span class="page-kicker">GESTION DE BARBERIA</span>

            <h1 class="page-title">

                <span class="page-icon">

                    <i class="bi bi-calendar3"></i>

                </span>

                Citas

            </h1>

            <p class="page-description">

                @(esCliente ? "Agenda tus citas y consulta tus horarios disponibles e historial." :
                    esBarbero ? "Crea reservas para tus clientes y consulta tus horarios disponibles." :
                    "Administra las citas, horarios y agenda de Yampi BarberShop.")

            </p>

        </div>

        <div class="header-decoration">

            <i class="bi bi-scissors"></i>

        </div>

    </section>

    <!-- =========================

         MENSAJES

    ========================== -->

    @if (mostrarMensaje)

    {

        <div class="alert-custom alert-success-custom">

            <div class="alert-icon">

                <i class="bi bi-check-lg"></i>

            </div>

            <div>

                <strong>Operacion realizada</strong>

                <span>@TempData["MensajeCita"]</span>

            </div>

        </div>

    }

    @if (mostrarError)

    {

        <div class="alert-custom alert-error-custom">

            <div class="alert-icon">

                <i class="bi bi-exclamation-lg"></i>

            </div>

            <div>

                <strong>No se pudo completar la operacion</strong>

                <span>@TempData["ErrorCita"]</span>

            </div>

        </div>

    }

    @if (esCliente && ViewBag.SinVinculacion is bool && (bool)ViewBag.SinVinculacion)
    {
        <div class="alert-custom alert-error-custom">
            <div class="alert-icon"><i class="bi bi-info-circle"></i></div>
            <div>
                <strong>Tu cuenta aun no tiene historial vinculado</strong>
                <span>Si tenias citas anteriores, solicita a administracion verificar la vinculacion de tu cuenta. Tus futuras reservas apareceran aqui.</span>
            </div>
        </div>
    }

    <!-- =========================

         RESUMEN

    ========================== -->

    <section class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">

                <i class="bi bi-calendar-check"></i>

            </div>

            <div class="stat-info">

                <span class="stat-label">Citas activas</span>

                <strong class="stat-number">@citasActivas.Count</strong>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">

                <i class="bi bi-calendar-event"></i>

            </div>

            <div class="stat-info">

                <span class="stat-label">Total de citas</span>

                <strong class="stat-number">@Model.Count</strong>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">

                <i class="bi bi-clock-history"></i>

            </div>

            <div class="stat-info">

                <span class="stat-label">Historial</span>

                <strong class="stat-number">@citasHistorial.Count</strong>

            </div>

        </div>

        @if (esAdministrador)
        {
        <div class="stat-card">

            <div class="stat-icon">

                <i class="bi bi-person-badge"></i>

            </div>

            <div class="stat-info">

                <span class="stat-label">Barberos</span>

                <strong class="stat-number">

                    @(ViewBag.Barberos?.Count ?? 0)

                </strong>

            </div>

        </div>
        }

    </section>

    <!-- =========================

         CREAR + HORARIOS

    ========================== -->

    @if (puedeCrear || puedeHorarios)
    {
    <section class="top-sections-grid">

        <!-- CREAR CITA -->

        @if (puedeCrear)
        {
        <div class="content-card create-card">

            <div class="card-header">

                <div>

                    <span class="card-kicker">NUEVA RESERVACION</span>

                    <h2>

                        <i class="bi bi-plus-circle"></i>

                        Crear cita

                    </h2>

                    <p>

                        Selecciona el barbero, fecha y hora.

                    </p>

                </div>

            </div>

            <form asp-action="Crear" asp-controller="Citas" method="post" id="formCrearCita">
                @if (esAdministrador || esBarbero)
                {
                    <div class="form-section selector-cliente" id="seccionBuscarCliente"
                         data-buscar-url="@Url.Action("BuscarClientes", "Citas")"
                         data-registrar-url="@Url.Action("RegistrarClienteRapido", "Citas")">
                        <div class="section-title">
                            <span class="step-number"><i class="bi bi-person"></i></span>
                            <div>
                                <strong>Cliente de la reserva</strong>
                                <small>Busca por nombre, telefono o identificador.</small>
                            </div>
                        </div>

                        <div class="cliente-buscador">
                            <label for="buscarCliente">Buscar cliente</label>
                            <div id="clienteZonaBusqueda" class="cliente-input-wrapper">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" id="buscarCliente" class="cliente-input"
                                       placeholder="Nombre, telefono o ID..."
                                       autocomplete="off" aria-controls="resultadosClientes"
                                       aria-expanded="false" aria-describedby="estadoBusquedaClientes" />
                            </div>
                            <input type="hidden" id="clienteSeleccionadoId" name="idCliente" value="" />
                            <div id="estadoBusquedaClientes" class="cliente-estado"
                                 role="status" aria-live="polite">Escribe al menos 2 caracteres.</div>
                            <div id="resultadosClientes" class="cliente-resultados"
                                 role="group" aria-label="Resultados de clientes" hidden></div>

                            <div id="clienteSeleccionado" class="cliente-seleccionado" hidden>
                                <span class="cliente-avatar" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                                <span class="cliente-seleccionado-info">
                                    <strong id="clienteNombreSeleccionado"></strong>
                                    <small id="clienteTelefonoSeleccionado"></small>
                                </span>
                                <button type="button" id="cambiarCliente" class="cliente-cambiar">Cambiar</button>
                            </div>

                            <button type="button" id="mostrarRegistroCliente" class="cliente-btn-nuevo">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Registrar cliente nuevo
                            </button>

                            <div id="registroRapidoCliente" class="cliente-registro" hidden>
                                <h3><i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo cliente</h3>
                                <label for="nuevoClienteNombre">Nombre completo</label>
                                <input type="text" id="nuevoClienteNombre" maxlength="100" autocomplete="name"
                                       placeholder="Nombre del cliente" />
                                <label for="nuevoClienteTelefono">Telefono</label>
                                <input type="tel" id="nuevoClienteTelefono" maxlength="20" autocomplete="tel"
                                       placeholder="8888-8888" />
                                <label for="nuevoClienteEmail">Correo electronico (opcional)</label>
                                <input type="email" id="nuevoClienteEmail" maxlength="100" autocomplete="email"
                                       placeholder="cliente@correo.com" />
                                <div id="errorNuevoCliente" class="cliente-error" role="alert" hidden></div>
                                <div class="cliente-registro-acciones">
                                    <button type="button" id="guardarNuevoCliente" class="cliente-btn-guardar">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar cliente
                                    </button>
                                    <button type="button" id="cancelarNuevoCliente" class="cliente-btn-cancelar">
                                        Cancelar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }


                <div class="form-section">

                    <div class="section-title">

                        <span class="step-number">01</span>

                        <div>

                            <strong>Selecciona un barbero</strong>

                            <small>Elige quien atendera la cita</small>

                        </div>

                    </div>

                    <div class="barber-select-grid">

                        @if (ViewBag.Barberos != null)

                        {

                            foreach (var barbero in ViewBag.Barberos)

                            {

                                <label class="barber-option">

                                    <input type="radio" name="idBarbero" value="@barbero.IdUsuario" required />

                                    <div class="barber-option-content">

                                        <div class="barber-avatar">

                                            @if (!string.IsNullOrEmpty(barbero.Nombre))

                                            {

                                                @barbero.Nombre.Substring(0, 1).ToUpper()

                                            }

                                            else

                                            {

                                                <text>?</text>

                                            }

                                        </div>

                                        <div class="barber-details">

                                            <strong>@barbero.Nombre</strong>

                                            <span>Barbero</span>

                                        </div>

                                        <i class="bi bi-check-circle-fill barber-check"></i>

                                    </div>

                                </label>

                            }

                        }

                    </div>

                </div>

                <div class="form-section">

                    <div class="section-title">

                        <span class="step-number">02</span>

                        <div>

                            <strong>Fecha y hora</strong>

                            <small>Selecciona cuando quieres tu cita</small>

                        </div>

                    </div>

                    <div class="datetime-grid">

                        <!-- FECHA -->

                        <div class="date-selector-box">

                            <div class="field-label">

                                <i class="bi bi-calendar3"></i>

                                <span>Fecha</span>

                            </div>

                            <div class="custom-date-selectors">

                                <!-- DIA -->

                                <div class="custom-select" data-name="dia">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">

                                            Dia

                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">

                                    </div>

                                </div>

                                <!-- MES -->

                                <div class="custom-select" data-name="mes">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">

                                            Mes

                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">

                                        <button type="button" data-value="1">

                                            Enero

                                        </button>

                                        <button type="button" data-value="2">

                                            Febrero

                                        </button>

                                        <button type="button" data-value="3">

                                            Marzo

                                        </button>

                                        <button type="button" data-value="4">

                                            Abril

                                        </button>

                                        <button type="button" data-value="5">

                                            Mayo

                                        </button>

                                        <button type="button" data-value="6">

                                            Junio

                                        </button>

                                        <button type="button" data-value="7">

                                            Julio

                                        </button>

                                        <button type="button" data-value="8">

                                            Agosto

                                        </button>

                                        <button type="button" data-value="9">

                                            Septiembre

                                        </button>

                                        <button type="button" data-value="10">

                                            Octubre

                                        </button>

                                        <button type="button" data-value="11">

                                            Noviembre

                                        </button>

                                        <button type="button" data-value="12">

                                            Diciembre

                                        </button>

                                    </div>

                                </div>

                                <!-- AÑO -->

                                <div class="custom-select" data-name="anio">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">

                                            Año

                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">

                                    </div>

                                </div>

                            </div>

                            <button type="button" class="today-btn" id="btnHoy">

                                <i class="bi bi-calendar-check"></i>

                                Hoy

                            </button>

                            <input type="hidden" id="fecha" name="fecha">

                        </div>

                        <!-- HORA -->

                        <div class="time-selector-box">

                            <div class="field-label">

                                <i class="bi bi-clock"></i>

                                <span>Hora</span>

                            </div>

                            <div class="custom-time-selectors">

                                <!-- HORA -->

                                <div class="custom-select" data-name="hora">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">

                                            Hora

                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">
                                        @for (int h = 7; h <= 20; h++)
                                        {
                                            <button type="button" data-value="@h.ToString("D2")">@($"{h:D2}:00")</button>
                                        }
                                    </div>

                                </div>

                                <!-- MINUTOS -->

                                <div class="custom-select" data-name="minuto">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">

                                            Minutos

                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">
                                        <button type="button" data-value="00">00</button>
                                        <button type="button" data-value="30">30</button>
                                    </div>

                                </div>

                            </div>

                            <input type="hidden" id="horaFinal" name="hora">

                        </div>

                    </div>

                </div>

                <div class="form-footer">

                    <div class="form-tip">

                        <i class="bi bi-info-circle"></i>

                        <span>

                            Verifica que el horario este disponible antes de reservar.

                        </span>

                    </div>

                    <button type="submit" class="primary-btn">

                        <i class="bi bi-calendar-plus"></i>

                        Crear cita

                    </button>

                </div>

            </form>

        </div>

        }

        <!-- HORARIOS -->

        @if (puedeHorarios)
        {

        <div class="content-card schedule-card">

            <div class="card-header">

                <div>

                    <span class="card-kicker">DISPONIBILIDAD</span>

                    <h2>

                        <i class="bi bi-clock"></i>

                        Horarios

                    </h2>

                    <p>

                        Consulta los espacios libres por barbero y fecha.

                    </p>

                </div>

            </div>

            <form asp-action="HorariosDisponibles" asp-controller="Citas" method="post" class="schedule-form">

                <div class="visual-date-field schedule-date">

                    <label>

                        <i class="bi bi-calendar3"></i>

                        Seleccionar fecha

                    </label>

                    <div class="schedule-custom-date">

                        <!-- DIA -->

                        <div class="custom-select" data-name="scheduleDia">

                            <button type="button" class="custom-select-trigger">

                                <span class="custom-select-value">

                                    Dia

                                </span>

                                <i class="bi bi-chevron-down"></i>

                            </button>

                            <div class="custom-select-menu">

                            </div>

                        </div>

                        <!-- MES -->

                        <div class="custom-select" data-name="scheduleMes">

                            <button type="button" class="custom-select-trigger">

                                <span class="custom-select-value">

                                    Mes

                                </span>

                                <i class="bi bi-chevron-down"></i>

                            </button>

                            <div class="custom-select-menu">

                            </div>

                        </div>

                        <!-- AÑO -->

                        <div class="custom-select" data-name="scheduleAnio">

                            <button type="button" class="custom-select-trigger">

                                <span class="custom-select-value">

                                    Año

                                </span>

                                <i class="bi bi-chevron-down"></i>

                            </button>

                            <div class="custom-select-menu">

                            </div>

                        </div>

                    </div>

                    <button type="button" class="today-btn" id="btnHoyHorarios">

                        <i class="bi bi-calendar-check"></i>

                        Hoy

                    </button>

                    <input type="hidden" id="fechaHorarios" name="fecha" required />

                </div>

                <button type="submit" class="secondary-btn schedule-btn">

                    <i class="bi bi-search"></i>

                    Consultar horarios

                </button>

            </form>

            <!-- Contenedor permanente para los resultados de AJAX -->

            <div id="contenedorResultadosHorario">

                @if (mostrarResultadoHorarios)

                {

                    var fechaConsultada = (DateOnly)ViewBag.FechaHorarios;

                    <div class="schedule-result">

                        <div class="schedule-result-header">

                            <div>

                                <span>HORARIOS DEL DIA</span>

                                <strong>

                                    @fechaConsultada.ToString("dd/MM/yyyy")

                                </strong>

                            </div>

                            <div class="schedule-date-icon">

                                <i class="bi bi-calendar-check"></i>

                            </div>

                        </div>

                        @{
                            var disponibilidades = ViewBag.Disponibilidades as List<WebApplicationAPP.Models.DisponibilidadDiaVM>
                                ?? new List<WebApplicationAPP.Models.DisponibilidadDiaVM>();
                        }
                        @if (disponibilidades.Any())
                        {
                            <div class="disponibilidad-grupos">
                                @foreach (var disp in disponibilidades)
                                {
                                    <div class="disponibilidad-grupo">
                                        <strong><i class="bi bi-person-badge"></i> @disp.Barbero</strong>
                                        @if (disp.HorasDisponibles.Any())
                                        {
                                            <div class="disponibilidad-horas">
                                                @foreach (var libre in disp.HorasDisponibles)
                                                {
                                                    <span class="hora-libre"><i class="bi bi-check-circle"></i> @libre</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="disponibilidad-vacia">No tiene espacios disponibles en esa fecha.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="schedule-empty">
                                <div class="schedule-empty-icon"><i class="bi bi-calendar-x"></i></div>
                                <strong>No hay horarios disponibles</strong>
                                <span>Selecciona otro dia de lunes a sabado.</span>
                            </div>
                        }

                    </div>

                }

            </div>

        </div>

        }
    </section>
    }

    <!-- ==========================================

        AGENDA - CITAS PROGRAMADAS

    ========================================== -->

    @if ((esAdministrador || esBarbero) && puedeMisCitas)
    {
    <section class="content-card agenda-card">

        <!-- ENCABEZADO -->

        <div class="card-header">

            <div>

                <span class="card-kicker">AGENDA</span>

                <h2>

                    <i class="bi bi-calendar2-week"></i>

                    Citas programadas

                </h2>

                <p>

                    Todas las citas activas actualmente.

                </p>

            </div>

            <div class="agenda-count">

                <span>@citasActivas.Count</span>

                <small>activas</small>

            </div>

        </div>

        @if (citasActivas.Any())

        {

            <!-- *======================================*

                COMPUTADORA - TABLA TRADICIONAL

            =*======================================* -->

            <div class="agenda-table-wrapper agenda-desktop">

                <table class="agenda-table">

                    <thead>

                        <tr>

                            <th>CLIENTE</th>

                            <th>FECHA</th>

                            <th>HORA</th>

                            <th>BARBERO</th>

                            <th>ESTADO</th>

                            <th class="text-center">ACCIONES</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var c in citasActivas)

                        {

                            <tr>

                                <!-- CLIENTE -->

                                <td>

                                    <div class="client-cell">

                                        <div class="cliente-avatar">

                                            @if (!string.IsNullOrEmpty(c.IdClienteNavigation?.Nombre))

                                            {

                                                @c.IdClienteNavigation.Nombre.Substring(0, 1).ToUpper()

                                            }

                                            else

                                            {

                                                <text>?</text>

                                            }

                                        </div>

                                        <div class="client-info">

                                            <strong>

                                                @(c.IdClienteNavigation?.Nombre ?? "Sin cliente")

                                            </strong>

                                            <span>Cliente</span>

                                        </div>

                                    </div>

                                </td>

                                <!-- FECHA -->

                                <td>

                                    <div class="date-cell">

                                        <i class="bi bi-calendar3"></i>

                                        <span>

                                            @c.Fecha.ToString("dd/MM/yyyy")

                                        </span>

                                    </div>

                                </td>

                                <!-- HORA -->

                                <td>

                                    <div class="time-cell">

                                        <i class="bi bi-clock"></i>

                                        <strong>

                                            @c.Hora.ToString("HH:mm")

                                        </strong>

                                    </div>

                                </td>

                                <!-- BARBERO -->

                                <td>

                                    <div class="barber-cell">

                                        <div class="small-barber-avatar">

                                            @if (!string.IsNullOrEmpty(c.Barbero))

                                            {

                                                @c.Barbero.Substring(0, 1).ToUpper()

                                            }

                                            else

                                            {

                                                <text>?</text>

                                            }

                                        </div>

                                        <span>@c.Barbero</span>

                                    </div>

                                </td>

                                <!-- ESTADO -->

                                <td>

                                    <span class="status status-active">

                                        <span></span>

                                        @c.Estado

                                    </span>

                                </td>

                                <!-- ACCIONES -->

                                <td>

                                    <div class="action-buttons">

                                        <!-- ATENDER -->

                                        @if (puedeRecibir)
                                        {
                                        <form method="post" asp-controller="Atencion" asp-action="RegistrarDesdeCita"
                                              class="citas-inline-form" asp-antiforgery="true">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-attend"
                                                    title="Registrar llegada" aria-label="Registrar llegada">
                                                <i class="bi bi-scissors"></i>
                                            </button>
                                        </form>
                                        }

                                        <!-- EDITAR -->

                                        @if (puedeEditar)
                                        {
                                        <button type="button" class="table-action action-edit btn-abrir-editar" title="Editar"

                                                aria-label="Editar cita" data-id="@c.IdCita" data-cliente-id="@c.IdCliente"

                                                data-cliente-nombre="@(c.IdClienteNavigation?.Nombre ?? "")"

                                                data-fecha="@c.Fecha.ToString("yyyy-MM-dd")" data-hora="@c.Hora.ToString("HH\\\\:mm")"

                                                data-barbero="@c.Barbero" data-barbero-id="@c.IdBarbero">

                                            <i class="bi bi-pencil"></i>

                                        </button>
                                        }

                                        <!-- BLOQUEAR -->

                                        @if (esAdministrador)
                                        {
                                        <form asp-controller="Citas" asp-action="Bloquear" method="post" asp-antiforgery="true" class="citas-inline-form" onsubmit="return confirm('¿Bloquear esta cita?');">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-block" title="Bloquear cita" aria-label="Bloquear cita"><i class="bi bi-lock"></i></button>
                                        </form>
                                        }

                                        <!-- CANCELAR -->

                                        @if (puedeCancelar)
                                        {
                                        <form asp-controller="Citas" asp-action="Cancelar" method="post" asp-antiforgery="true" class="citas-inline-form" onsubmit="return confirm('¿Cancelar esta cita?');">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-cancel" title="Cancelar cita" aria-label="Cancelar cita"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

            <!-- *======================================*

                TABLET Y CELULAR - CARRUSEL

            =*======================================* -->

            <div class="agenda-mobile">

                <div class="citas-carousel">

                    @foreach (var c in citasActivas)

                    {

                        <article class="cita-carousel-card">

                            <!-- CLIENTE Y ESTADO -->

                            <div class="cita-card-top">

                                <div class="cita-card-client">

                                    <div class="cliente-avatar">

                                        @if (!string.IsNullOrEmpty(c.IdClienteNavigation?.Nombre))

                                        {

                                            @c.IdClienteNavigation.Nombre.Substring(0, 1).ToUpper()

                                        }

                                        else

                                        {

                                            <text>?</text>

                                        }

                                    </div>

                                    <div class="cita-card-client-info">

                                        <strong>

                                            @(c.IdClienteNavigation?.Nombre ?? "Sin cliente")

                                        </strong>

                                        <span>Cliente</span>

                                    </div>

                                </div>

                                <span class="status status-active">

                                    <span></span>

                                    @c.Estado

                                </span>

                            </div>

                            <!-- INFORMACION -->

                            <div class="cita-card-details">

                                <!-- FECHA -->

                                <div class="cita-card-detail">

                                    <span class="cita-card-label">

                                        <i class="bi bi-calendar3"></i>

                                        Fecha

                                    </span>

                                    <strong>

                                        @c.Fecha.ToString("dd/MM/yyyy")

                                    </strong>

                                </div>

                                <!-- HORA -->

                                <div class="cita-card-detail">

                                    <span class="cita-card-label">

                                        <i class="bi bi-clock"></i>

                                        Hora

                                    </span>

                                    <strong>

                                        @c.Hora.ToString("HH:mm")

                                    </strong>

                                </div>

                                <!-- BARBERO -->

                                <div class="cita-card-detail">

                                    <span class="cita-card-label">

                                        <i class="bi bi-scissors"></i>

                                        Barbero

                                    </span>

                                    <strong>

                                        @c.Barbero

                                    </strong>

                                </div>

                            </div>

                            <!-- ACCIONES -->

                            <div class="cita-card-footer">

                                <span class="cita-card-actions-title">

                                    Acciones

                                </span>

                                <div class="action-buttons">

                                    <!-- ATENDER -->

                                    @if (puedeRecibir)
                                    {
                                    <form method="post" asp-controller="Atencion" asp-action="RegistrarDesdeCita"
                                              class="citas-inline-form" asp-antiforgery="true">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-attend"
                                                    title="Registrar llegada" aria-label="Registrar llegada">
                                                <i class="bi bi-scissors"></i>
                                            </button>
                                        </form>
                                    }

                                    <!-- EDITAR -->

                                    @if (puedeEditar)
                                    {
                                    <button type="button" class="table-action action-edit btn-abrir-editar" title="Editar"

                                            aria-label="Editar cita" data-id="@c.IdCita" data-cliente-id="@c.IdCliente"

                                            data-cliente-nombre="@(c.IdClienteNavigation?.Nombre ?? "")"

                                            data-fecha="@c.Fecha.ToString("yyyy-MM-dd")" data-hora="@c.Hora.ToString("HH\\\\:mm")"

                                            data-barbero="@c.Barbero" data-barbero-id="@c.IdBarbero">

                                        <i class="bi bi-pencil"></i>

                                    </button>
                                    }

                                    <!-- BLOQUEAR -->

                                    @if (esAdministrador)
                                    {
                                    <form asp-controller="Citas" asp-action="Bloquear" method="post" asp-antiforgery="true" class="citas-inline-form" onsubmit="return confirm('¿Bloquear esta cita?');">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-block" title="Bloquear cita" aria-label="Bloquear cita"><i class="bi bi-lock"></i></button>
                                        </form>
                                    }

                                    <!-- CANCELAR -->

                                    @if (puedeCancelar)
                                    {
                                    <form asp-controller="Citas" asp-action="Cancelar" method="post" asp-antiforgery="true" class="citas-inline-form" onsubmit="return confirm('¿Cancelar esta cita?');">
                                            <input type="hidden" name="id" value="@c.IdCita" />
                                            <button type="submit" class="table-action action-cancel" title="Cancelar cita" aria-label="Cancelar cita"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    }

                                </div>

                            </div>

                        </article>

                    }

                </div>

            </div>

        }

        else

        {

            <!-- SIN CITAS -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-calendar-x"></i>

                </div>

                <h3>No hay citas programadas</h3>

                <p>

                    Actualmente no existen citas activas.

                </p>

            </div>

        }

    </section>

    }

    <!-- *=========================*

         EDITAR CITA (DESLIZANTE)

    =*=========================* -->

    @{

        // Verificar si existe una cita para editar

        bool hayCitaEdit = citaEditar != null;

        // Datos de la cita

        int idEdit = citaEditar?.IdCita ?? 0;

        int idClienteEdit = citaEditar?.IdCliente ?? 0;

        // Datos del cliente

        string nombreEdit =

            citaEditar?.IdClienteNavigation?.Nombre ?? "Sin cliente";

        string inicialEdit = !string.IsNullOrWhiteSpace(nombreEdit)

            ? nombreEdit.Substring(0, 1).ToUpper()

            : "?";

        // Datos del barbero

        string barberoEdit = citaEditar?.Barbero ?? "";

        // Datos de la fecha

        string strFecha =

            citaEditar?.Fecha.ToString("yyyy-MM-dd") ?? "";

        string strDia =

            citaEditar?.Fecha.Day.ToString("D2") ?? "Dia";

        int numMes = citaEditar?.Fecha.Month ?? 1;

        string[] mesesArray =

        {

        "Enero", "Febrero", "Marzo", "Abril",

        "Mayo", "Junio", "Julio", "Agosto",

        "Septiembre", "Octubre", "Noviembre", "Diciembre"

    };

        string nombreMesEdit = hayCitaEdit

            ? mesesArray[numMes - 1]

            : "Mes";

        string strAnio =

            citaEditar?.Fecha.Year.ToString() ?? "Año";

        // Datos de la hora

        string strHora =

            citaEditar?.Hora.ToString("HH\\\\:mm") ?? "";

        string strH =

            citaEditar?.Hora.Hour.ToString("D2") ?? "07";

        string strM =

            citaEditar?.Hora.Minute.ToString("D2") ?? "00";

        string strHLbl = citaEditar != null

            ? strH + ":" + strM

            : "Hora";

    }

    @if (esAdministrador || puedeEditar)
    {
    <div class="edit-drawer-container closed" id="editDrawerContainer">

        <section class="content-card edit-card">

            <div class="card-header">

                <div>

                    <span class="card-kicker">MODIFICAR RESERVACION</span>

                    <h2>

                        <i class="bi bi-pencil-square"></i>

                        Editar cita

                    </h2>

                    <p>Actualiza la fecha, hora o barbero de la cita.</p>

                </div>

                <div class="edit-id" id="editIdBadge">#@idEdit</div>

            </div>

            <form asp-action="Editar" asp-controller="Citas" method="post" id="formEditarCita" style="padding: 0;">

                <input type="hidden" id="editInputIdCita" name="IdCita" value="@idEdit" />

                <input type="hidden" id="editInputIdCliente" name="IdCliente" value="@idClienteEdit" />

                <!-- SECCIÓN CLIENTE -->

                <div class="form-section">

                    <div class="edit-client" style="margin-bottom: 0;">

                        <div class="cliente-avatar large" id="editAvatarCliente">@inicialEdit</div>

                        <div>

                            <span>Cliente</span>

                            <strong id="editNombreCliente">@nombreEdit</strong>

                        </div>

                    </div>

                </div>

                <!-- SECCIÓN BARBERO -->

                <div class="form-section">

                    <div class="section-title">

                        <span class="step-number">01</span>

                        <div>

                            <strong>Selecciona un barbero</strong>

                            <small>Elige quien atenderá la cita</small>

                        </div>

                    </div>

                    <div class="barber-select-grid">

                        @if (ViewBag.Barberos != null)

                        {

                            foreach (var barbero in ViewBag.Barberos)

                            {

                                bool isSelected = (barbero.IdUsuario == citaEditar?.IdBarbero);

                                <label class="barber-option">

                                    <input type="radio" name="IdBarbero" value="@barbero.IdUsuario" checked="@isSelected"

                                           required />

                                    <div class="barber-option-content">

                                        <div class="barber-avatar">

                                            @(!string.IsNullOrEmpty(barbero.Nombre) ? barbero.Nombre.Substring(0, 1).ToUpper() : "?")

                                        </div>

                                        <div class="barber-details">

                                            <strong>@barbero.Nombre</strong>

                                            <span>Barbero</span>

                                        </div>

                                        <i class="bi bi-check-circle-fill barber-check"></i>

                                    </div>

                                </label>

                            }

                        }

                    </div>

                </div>

                <!-- SECCIÓN FECHA Y HORA -->

                <div class="form-section">

                    <div class="section-title">

                        <span class="step-number">02</span>

                        <div>

                            <strong>Fecha y hora</strong>

                            <small>Actualiza cuándo quieres tu cita</small>

                        </div>

                    </div>

                    <div class="datetime-grid">

                        <div class="date-selector-box">

                            <div class="field-label">

                                <i class="bi bi-calendar3"></i> <span>Fecha</span>

                            </div>

                            <div class="custom-date-selectors">

                                <div class="custom-select" data-name="editDia">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">@strDia</span> <i

                                        class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu"></div>

                                </div>

                                <div class="custom-select" data-name="editMes">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">@nombreMesEdit</span> <i

                                        class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">

                                        @for (int m = 1; m <= 12; m++)

                                        {

                                            <button type="button" data-value="@m"

                                                    class="@(numMes == m && hayCitaEdit ? "selected" : "")">

                                                @mesesArray[m - 1]

                                            </button>

                                        }

                                    </div>

                                </div>

                                <div class="custom-select" data-name="editAnio">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">@strAnio</span> <i

                                        class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu"></div>

                                </div>

                            </div>

                            <button type="button" class="today-btn" id="btnHoyEdit">

                                <i class="bi bi-calendar-check"></i> Hoy

                            </button>

                            <input type="hidden" id="editFecha" name="Fecha" value="@strFecha">

                        </div>

                        <div class="time-selector-box">

                            <div class="field-label">

                                <i class="bi bi-clock"></i> <span>Hora</span>

                            </div>

                            <div class="custom-time-selectors">

                                <div class="custom-select" data-name="editHora">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">@strHLbl</span> <i

                                        class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">
                                        @for (int h = 7; h <= 20; h++)
                                        {
                                            <button type="button" data-value="@h.ToString("D2")">@($"{h:D2}:00")</button>
                                        }
                                    </div>

                                </div>

                                <div class="custom-select" data-name="editMinuto">

                                    <button type="button" class="custom-select-trigger">

                                        <span class="custom-select-value">@strM</span> <i

                                        class="bi bi-chevron-down"></i>

                                    </button>

                                    <div class="custom-select-menu">
                                        <button type="button" data-value="00">00</button>
                                        <button type="button" data-value="30">30</button>
                                    </div>

                                </div>

                            </div>

                            <input type="hidden" id="editHoraFinal" name="Hora" value="@strHora">

                        </div>

                    </div>

                </div>

                <!-- FOOTER -->

                <div class="form-footer">

                    <div class="form-tip">

                        <i class="bi bi-info-circle"></i> <span>Verifica la disponibilidad antes de actualizar.</span>

                    </div>

                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px;">

                        <!-- BOTÓN CANCELAR REPARADO -->

                        <button type="button" class="secondary-btn btn-cerrar-editar">

                            <i class="bi bi-x-lg"></i>

                            Cancelar

                        </button>

                        <button type="submit" class="primary-btn">

                            <i class="bi bi-check-lg"></i> Guardar cambios

                        </button>

                    </div>

                </div>

            </form>

        </section>

    </div>

    <!-- *=========================*

         HISTORIAL

    =*=========================* -->

    <!-- *=========================*

     HISTORIAL

    =*=========================* -->

    }

    @if (esCliente && puedeMisCitas)
    {
        <section class="content-card agenda-card cliente-agenda">
            <div class="card-header">
                <div>
                    <span class="card-kicker">TU AGENDA</span>
                    <h2><i class="bi bi-calendar-check"></i> Mis citas activas</h2>
                    <p>Estas reservas pertenecen exclusivamente a tu cuenta.</p>
                </div>
                <div class="agenda-count"><span>@citasActivas.Count</span><small>activas</small></div>
            </div>
            @if (citasActivas.Any())
            {
                <div class="cliente-citas-grid">
                    @foreach (var cita in citasActivas)
                    {
                        <article class="cliente-cita-card">
                            <div class="cliente-cita-cabecera">
                                <span class="status status-active"><span></span> Activa</span>
                                <strong>#@cita.IdCita</strong>
                            </div>
                            <h3><i class="bi bi-calendar3"></i> @cita.Fecha.ToString("dd/MM/yyyy")</h3>
                            <p><i class="bi bi-clock"></i> @cita.Hora.ToString("HH:mm")</p>
                            <p><i class="bi bi-scissors"></i> @cita.Barbero</p>
                            <div class="cliente-cita-acciones">
                                @if (puedeEditar)
                                {
                                    <button type="button" class="table-action action-edit btn-abrir-editar"
                                        title="Editar mi cita" aria-label="Editar cita"
                                        data-id="@cita.IdCita" data-cliente-id="@cita.IdCliente"
                                        data-cliente-nombre="@(cita.IdClienteNavigation?.Nombre ?? "")"
                                        data-fecha="@cita.Fecha.ToString("yyyy-MM-dd")"
                                        data-hora="@cita.Hora.ToString("HH:mm")"
                                        data-barbero="@cita.Barbero" data-barbero-id="@cita.IdBarbero">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                }
                                @if (puedeCancelar)
                                {
                                    <form asp-controller="Citas" asp-action="Cancelar" method="post" asp-antiforgery="true" class="citas-inline-form"
                                          onsubmit="return confirm('¿Cancelar esta cita?');">
                                        <input type="hidden" name="id" value="@cita.IdCita" />
                                        <button type="submit" class="table-action action-cancel" title="Cancelar mi cita">
                                            <i class="bi bi-x-lg"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-calendar-x"></i></div>
                    <h3>No tienes citas activas</h3>
                    <p>Puedes reservar una cita usando el formulario de arriba.</p>
                </div>
            }
        </section>
    }

    @if (esAdministrador || puedeMisCitas)
    {
    <section class="content-card history-card">

        <div class="card-header">

            <div>

                <span class="card-kicker">REGISTRO</span>

                <h2>

                    <i class="bi bi-clock-history"></i>

                    @(esCliente ? "Mi historial de citas" : "Historial de citas")

                </h2>

                <p>

                    @(esCliente ? "Tus citas finalizadas y canceladas." : "Citas finalizadas, canceladas y bloqueadas.")

                </p>

            </div>

        </div>

        @if (citasHistorial.Any())

        {

            <div class="history-list" id="historialCitas">

                @foreach (var c in citasHistorial)

                {

                    <div class="history-item historial-cita-row">

                        <div class="history-main">

                            <div class="history-client">

                                <div class="cliente-avatar">

                                    @if (!string.IsNullOrEmpty(c.IdClienteNavigation?.Nombre))

                                    {

                                        @c.IdClienteNavigation.Nombre.Substring(0, 1).ToUpper()

                                    }

                                    else

                                    {

                                        <text>?</text>

                                    }

                                </div>

                                <div>

                                    <strong>

                                        @(c.IdClienteNavigation?.Nombre ?? "Sin cliente")

                                    </strong>

                                    <span>

                                        @c.Barbero

                                    </span>

                                </div>

                            </div>

                            <div class="history-date">

                                <div>

                                    <i class="bi bi-calendar3"></i>

                                    <span>

                                        @c.Fecha.ToString("dd/MM/yyyy")

                                    </span>

                                </div>

                                <div>

                                    <i class="bi bi-clock"></i>

                                    <span>

                                        @c.Hora.ToString("HH:mm")

                                    </span>

                                </div>

                            </div>

                            @if (c.Estado == "Cancelada")

                            {

                                <span class="status status-cancelled">

                                    <span></span>

                                    Cancelada

                                </span>

                            }

                            else if (c.Estado == "Finalizada")
                            {
                                <span class="status status-finalizada"><span></span> Finalizada</span>
                            }
                            else

                            {

                                <span class="status status-blocked">

                                    <span></span>

                                    Bloqueada

                                </span>

                            }

                        </div>

                    </div>

                }

            </div>

            <!-- PAGINACION -->

            <div id="historialPaginacion" class="historial-paginacion">

                <button type="button" id="historialAnterior" class="pagination-btn" title="Pagina anterior">

                    <i class="bi bi-chevron-left"></i>

                </button>

                <div id="historialNumeros" class="pagination-numbers"></div>

                <button type="button" id="historialSiguiente" class="pagination-btn" title="Pagina siguiente">

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

        }

        else

        {

            <div class="empty-state history-empty">

                <div class="empty-icon">

                    <i class="bi bi-clock"></i>

                </div>

                <h3>Historial vacio</h3>

                <p>

                    No existen citas finalizadas o canceladas.

                </p>

            </div>

        }

    </section>

    }

    <script src="~/js/clientes-buscador.js" asp-append-version="true"></script>

    <script src="~/js/citas.js"

        asp-append-version="true"></script>

    <script src="~/js/citas-validacion.js"

            asp-append-version="true"></script>

</div>
