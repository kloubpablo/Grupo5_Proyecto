@using System
@using System.Collections.Generic
@using System.Linq
@using WebApplicationAPP.Models
@using WebApplicationAPP.Helpers

@using Microsoft.EntityFrameworkCore

@inject YampiBarbershopContext Db


@{

    var usuarioSesionId = Context.Session.GetInt32("IdUsuario");
    var usuarioNav = usuarioSesionId.HasValue
        ? Db.Usuarios.AsNoTracking().Include(u => u.IdRolNavigation)
            .FirstOrDefault(u => u.IdUsuario == usuarioSesionId.Value && u.Estado && !u.ContraTemp && u.IdRolNavigation.Estado)
        : null;
    var rol = usuarioNav?.IdRolNavigation.Nombre;
    var esAdmin = rol == "Administrador";
    var permisosNav = usuarioNav == null || esAdmin
        ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        : PermisosHelper.ObtenerPermisos(Db, usuarioNav);
    bool mostrarDashboard = esAdmin || permisosNav.Contains("Dashboard/Index");
    bool mostrarCitas = esAdmin || new[] { "Citas/Crear", "Citas/MisCitas", "Citas/HorariosDisponibles" }
        .Any(p => permisosNav.Contains(p));
    bool mostrarAtencion = esAdmin || permisosNav.Contains("Atencion/Index");
    bool mostrarPagos = esAdmin || permisosNav.Contains("Pagos/Index");
    bool mostrarClientes = esAdmin || permisosNav.Contains("Clientes/Index");
    var controladorInicio = mostrarDashboard ? "Dashboard" : mostrarCitas ? "Citas" :
        mostrarAtencion ? "Atencion" : mostrarPagos ? "Pagos" : "Home";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <link rel="icon" type="image/png" href="~/assets/css/images/yampi.png" />

    <meta charset="utf-8" />

    <meta name="viewport"

          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Yampi Barbershop</title>

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"

          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"

          rel="stylesheet" />

    <!-- CSS general -->

    <link rel="stylesheet"

          href="~/css/site.css"

          asp-append-version="true" />

    <link rel="stylesheet"

          href="~/assets/css/main.css" />

    <link rel="stylesheet"

        href="~/css/layout.css"

        asp-append-version="true" />

    <!-- Correcciones globales para pantallas con escalado y resoluciones menores -->
    <link rel="stylesheet" href="~/css/yampi-responsive-global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yampi-logo.css" asp-append-version="true" />
</head>

<body>

    <div id="page-wrapper">

        <!-- =================================================

             NAVEGACION

        ================================================== -->

        <nav id="nav" class="yampi-nav" aria-label="Navegacion principal">

            <!-- Marca independiente de la lista: la plantilla antigua no puede separarla -->
            <a class="yampi-nav-brand yampi-logo" asp-controller="@controladorInicio" asp-action="Index" aria-label="Yampi BarberShop - Inicio">
                <span class="yampi-logo-icon" aria-hidden="true"><i class="bi bi-scissors"></i></span>
                <span class="yampi-logo-text">
                    <strong>YAMPI</strong>
                    <small>BARBERSHOP</small>
                </span>
            </a>

            <ul id="yampiPrimaryNav" class="yampi-priority-links" aria-label="Accesos principales">

                @if (!string.IsNullOrEmpty(rol))

                {

                    <!-- INICIO -->

                    if (mostrarDashboard)

                    {

                        <li>

                            <a asp-controller="Dashboard"

                               asp-action="Index">

                                <i class="bi bi-house"></i>

                                @(rol == "Barbero" ? "Mi Dashboard" : "Inicio")

                            </a>

                        </li>

                    }

                    <!-- CLIENTES -->

                    if (mostrarClientes)

                    {

                        <li>

                            <a asp-controller="Clientes"

                               asp-action="Index">

                                <i class="bi bi-people"></i>

                                Clientes

                            </a>

                        </li>

                    }

                    <!-- CITAS -->

                    if (mostrarCitas)
                    {

                        <li>

                            <a asp-controller="Citas"

                               asp-action="Index">

                                <i class="bi bi-calendar-check"></i>

                                Citas

                            </a>

                        </li>

                    }

                    <!-- ATENCION -->

                    if (mostrarAtencion)

                    {

                        <li>

                            <a asp-controller="Atencion"

                               asp-action="Index">

                                <i class="bi bi-scissors"></i>

                                Atención

                            </a>

                        </li>

                    }

                    <!-- PAGOS -->

                    if (mostrarPagos)

                    {

                        <li>

                            <a asp-controller="Pagos"

                               asp-action="Index">

                                <i class="bi bi-credit-card"></i>

                                @(rol == "Barbero" ? "Mis Pagos" : "Pagos")

                            </a>

                        </li>

                    }

                    <!-- REPORTES -->

                    if (esAdmin)

                    {

                        <li>

                            <a asp-controller="Reportes"

                               asp-action="Index">

                                <i class="bi bi-graph-up"></i>

                                Reportes

                            </a>

                        </li>

                    }

                    <!-- ROLES -->

                    if (esAdmin)

                    {

                        <li>

                            <a asp-controller="Roles"

                               asp-action="Index">

                                <i class="bi bi-shield-check"></i>

                                Roles

                            </a>

                        </li>

                    }

                    <!-- USUARIOS -->

                    if (esAdmin)

                    {

                        <li>

                            <a asp-controller="Usuarios"

                               asp-action="Index">

                                <i class="bi bi-person-gear"></i>

                                Usuarios

                            </a>

                        </li>

                    }

                    <!-- CONTROLES EXTERNOS -->
                    if (esAdmin)
                    {
                        <li class="yampi-controls-item">
                            <button type="button" id="yampiControlsToggle"
                                    class="yampi-controls-toggle"
                                    aria-controls="yampiControlsMenu"
                                    aria-expanded="false">
                                <i class="bi bi-tools" aria-hidden="true"></i>
                                <span>Controles externos</span>
                                <i class="bi bi-chevron-down yampi-controls-chevron" aria-hidden="true"></i>
                            </button>
                            <ul id="yampiControlsMenu" class="yampi-controls-submenu" hidden>
                                <li>
                                    <a asp-controller="YampiBarberShop" asp-action="ControlGaleria">
                                        <i class="bi bi-images" aria-hidden="true"></i>
                                        Control Galería
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="YampiBarberShop" asp-action="ControlServicio">
                                        <i class="bi bi-scissors" aria-hidden="true"></i>
                                        Control Servicios
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="YampiBarberShop" asp-action="ControlContacto">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                        Control Contacto
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                }

            </ul>

            <div class="yampi-priority-actions">
                <!-- Solo aparece si realmente hay enlaces sin espacio en la barra -->
                <div class="yampi-more-wrap" id="yampiMoreWrap" hidden>
                    <button id="yampiMenuToggle" class="yampi-more-toggle" type="button"
                            aria-label="Abrir menú de navegación" aria-controls="yampiMenu"
                            aria-expanded="false" title="Navegación">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <ul id="yampiMenu" class="yampi-more-menu"
                        aria-label="Opciones adicionales de navegación" hidden></ul>
                </div>
                @if (usuarioNav != null)
                {
                    <!-- Perfil permanece a la derecha; salir se mantiene accesible sin ocupar el menú -->
                    <div id="yampiProfileSlot" class="yampi-profile-slot">
                        <button id="yampiProfileToggle" type="button" class="yampi-profile-toggle"
                                aria-label="Abrir opciones de perfil" aria-controls="yampiProfileMenu"
                                aria-expanded="false" title="Mi perfil">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </button>
                        <ul id="yampiProfileMenu" class="yampi-profile-menu" hidden>
                            <li>
                                <a asp-controller="Usuarios" asp-action="Perfil">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                                    Mi perfil
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Seguridad" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    Salir
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>

            <!-- Fondo para cerrar el panel lateral solo en telefonos -->
            <div id="yampiNavBackdrop" class="yampi-nav-backdrop" hidden></div>
        </nav>

        <!-- =================================================

             CONTENIDO

             IMPORTANTE:

             NO HAY .container AQUI

        ================================================== -->

        <section id="main">

            @RenderBody()

        </section>

    </div>

<!-- ==========================================

     FOOTER - YAMPI BARBERSHOP

\========================================== -->

<footer id="footer" class="yampi-footer">

    <div class="yampi-footer-container">

        <!-- CONTENIDO PRINCIPAL -->

        <div class="yampi-footer-grid">

            <!-- MARCA -->

            <div class="yampi-footer-brand">

                <div class="yampi-footer-logo">

                    <span class="yampi-footer-logo-icon">

                        <i class="bi bi-scissors"></i>

                    </span>

                    <div class="yampi-footer-logo-text">

                        <h2>YAMPI</h2>

                        <span>BARBER SHOP</span>

                    </div>

                </div>

                <p class="yampi-footer-description">

                    Tu estilo, nuestra pasion.

                    Un espacio dedicado al cuidado personal,

                    la buena atencion y los detalles

                    que marcan la diferencia.

                </p>

                <div class="yampi-footer-location">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span>

                        San Jose, Costa Rica

                    </span>

                </div>

            </div>

            <!-- CONTACTO -->

            <div class="yampi-footer-column">

                <h3>Contacto</h3>

                <div class="yampi-footer-heading-line"></div>

                <div class="yampi-footer-contact-list">

                    <!-- DIRECCION -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-geo-alt"></i>

                        </span>

                        <div>

                            <strong>Direccion</strong>

                            <p>

                                Avenida Central, 200 metros

                                norte del Parque Central,

                                San Jose, Costa Rica.

                            </p>

                        </div>

                    </div>

                    <!-- TELEFONO -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-telephone"></i>

                        </span>

                        <div>

                            <strong>Telefono</strong>

                            <a href="tel:+50622558888">

                                +506 2255-8888

                            </a>

                        </div>

                    </div>

                    <!-- WHATSAPP -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-whatsapp"></i>

                        </span>

                        <div>

                            <strong>WhatsApp</strong>

                            <!-- Agregar enlace real despues -->

                            <a href=""

                               target="_blank"

                               rel="noopener noreferrer">

                                +506 8888-9999

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <!-- HORARIOS -->

            <div class="yampi-footer-column">

                <h3>Horario de atencion</h3>

                <div class="yampi-footer-heading-line"></div>

                <p class="yampi-footer-hours-description">

                    Estamos para atenderte durante

                    la semana y los sabados.

                </p>

                <div class="yampi-footer-hours">

                    <div class="yampi-footer-hours-row">

                        <span>Lunes a Sabado</span>

                        <strong>

                            7:00 AM - 9:00 PM

                        </strong>

                    </div>


                </div>

                <div class="yampi-footer-hours-note">

                    <i class="bi bi-clock"></i>

                    <span>

                        Abiertos todos los dias para brindarte

                        la mejor atencion.

                    </span>

                </div>

            </div>

            <!-- REDES SOCIALES -->

            <div class="yampi-footer-column">

                <h3>Siguenos</h3>

                <div class="yampi-footer-heading-line"></div>

                <p class="yampi-footer-social-description">

                    Conecta con nosotros a traves

                    de nuestras redes sociales.

                </p>

                <div class="yampi-footer-social-list">

                    <!-- INSTAGRAM -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-instagram"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>Instagram</strong>

                            <small>

                                @@YampiBarberShop

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                    <!-- FACEBOOK -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-facebook"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>Facebook</strong>

                            <small>

                                Yampi BarberShopFB

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                    <!-- TIKTOK -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-tiktok"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>TikTok</strong>

                            <small>

                                @@YampiBarberShopCR

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                </div>

            </div>

        </div>

        <!-- SEPARADOR -->

        <div class="yampi-footer-divider"></div>

        <!-- PARTE INFERIOR -->

        <div class="yampi-footer-bottom">

            <div class="yampi-footer-copyright">

                <span>

                    &copy; @DateTime.Now.Year Yampi BarberShop.

                    Todos los derechos reservados.

                </span>

            </div>

            <div class="yampi-footer-bottom-right">

                <span>

                    <i class="bi bi-geo-alt"></i>

                    San Jose, Costa Rica

                </span>

                <span class="yampi-footer-bottom-separator"></span>

                <span class="yampi-footer-bottom-brand">

                    YAMPI BARBER SHOP

                </span>

            </div>

        </div>

    </div>

</footer>

    <!-- =====================================================

         SCRIPTS

    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/assets/js/jquery.min.js"></script>

    @* Dropdowns gestionados por Bootstrap y navegacion prioritaria; evitar menus duplicados de Dropotron. *@

    <script src="~/assets/js/jquery.scrolly.min.js"></script>

    <script src="~/assets/js/browser.min.js"></script>

    <script src="~/assets/js/breakpoints.min.js"></script>

    <script src="~/assets/js/util.js"></script>

    
    <script src="~/js/layout-responsive.js" asp-append-version="true"></script>

</body>

</html>
