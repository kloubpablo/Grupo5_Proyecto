@using WebApplicationAPP.Models

@using Microsoft.EntityFrameworkCore

@inject YampiBarbershopContext Db


@{

    var rol = Context.Session.GetString("Rol");

    var esAdmin = rol == "Administrador";

}

<!DOCTYPE html>

<html lang="es">

<head>

    <link rel="icon" type="image/png" href="~/assets/css/images/yampi.png" />

    <meta charset="utf-8" />

    <meta name="viewport"

          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Yampi Barbershop</title>

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"

          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"

          rel="stylesheet" />

    <!-- CSS general -->

    <link rel="stylesheet"

          href="~/css/site.css"

          asp-append-version="true" />

    <link rel="stylesheet"

          href="~/assets/css/main.css" />

    <link rel="stylesheet"

        href="~/css/layout.css"

        asp-append-version="true" />

</head>

<body>

    <div id="page-wrapper">

        <!-- =================================================

             NAVEGACION

        ================================================== -->

        <nav id="nav" aria-label="Navegacion principal">

            <!-- Encabezado para telefonos y tablets -->
            <div class="yampi-mobile-bar">
                <a class="yampi-mobile-brand" asp-controller="Dashboard" asp-action="Index">
                    <span aria-hidden="true">💈</span> Yampi BarberShop
                </a>
                <button id="yampiMenuToggle" class="yampi-menu-toggle"
                        type="button" aria-label="Abrir menu"
                        aria-controls="yampiMenu" aria-expanded="false">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

            <ul id="yampiMenu" class="yampi-nav-list">

                <!-- LOGO -->

                <li>

                    <h1>

                        <a asp-controller="Dashboard"

                           asp-action="Index">

                            💈 Yampi Barbershop

                        </a>

                    </h1>

                </li>

                @if (!string.IsNullOrEmpty(rol))

                {

                    <!-- INICIO -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Dashboard/Index"))

                    {

                        <li>

                            <a asp-controller="Dashboard"

                               asp-action="Index">

                                <i class="bi bi-house"></i>

                                Inicio

                            </a>

                        </li>

                    }

                    <!-- CLIENTES -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Clientes/Index"))

                    {

                        <li>

                            <a asp-controller="Clientes"

                               asp-action="Index">

                                <i class="bi bi-people"></i>

                                Clientes

                            </a>

                        </li>

                    }

                    <!-- CITAS -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Citas/Index"))

                    {

                        <li>

                            <a asp-controller="Citas"

                               asp-action="Index">

                                <i class="bi bi-calendar-check"></i>

                                Citas

                            </a>

                        </li>

                    }

                    <!-- ATENCION -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Atencion/Index"))

                    {

                        <li>

                            <a asp-controller="Atencion"

                               asp-action="Index">

                                <i class="bi bi-scissors"></i>

                                Atención

                            </a>

                        </li>

                    }

                    <!-- PAGOS -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Pagos/Index"))

                    {

                        <li>

                            <a asp-controller="Pagos"

                               asp-action="Index">

                                <i class="bi bi-credit-card"></i>

                                Pagos

                            </a>

                        </li>

                    }

                    <!-- REPORTES -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Reportes/Index"))

                    {

                        <li>

                            <a asp-controller="Reportes"

                               asp-action="Index">

                                <i class="bi bi-graph-up"></i>

                                Reportes

                            </a>

                        </li>

                    }

                    <!-- ROLES -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Roles/Index"))

                    {

                        <li>

                            <a asp-controller="Roles"

                               asp-action="Index">

                                <i class="bi bi-shield-check"></i>

                                Roles

                            </a>

                        </li>

                    }

                    <!-- USUARIOS -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Usuarios/Index"))

                    {

                        <li>

                            <a asp-controller="Usuarios"

                               asp-action="Index">

                                <i class="bi bi-person-gear"></i>

                                Usuarios

                            </a>

                        </li>

                    }

                    <!-- CONTROLES EXTERNOS -->

                    if (esAdmin ||

                        WebApplicationAPP.Helpers.PermisosHelper.TienePermiso(

                            Db,

                            rol,

                            "Usuarios/Index"))

                    {

                        <li class="dropdown">

                            <a href="#"

                               class="dropdown-toggle"

                               data-bs-toggle="dropdown"

                               aria-expanded="false">

                                <i class="bi bi-tools"></i>

                                Controles externos

                            </a>

                            <ul class="dropdown-menu">

                                <li>

                                    <a asp-controller="YampiBarberShop"

                                       asp-action="ControlGaleria">

                                        <i class="bi bi-images"></i>

                                        Control Galería

                                    </a>

                                </li>

                                <li>

                                    <a asp-controller="YampiBarberShop"

                                       asp-action="ControlServicio">

                                        <i class="bi bi-scissors"></i>

                                        Control Servicios

                                    </a>

                                </li>

                                <li>

                                    <a asp-controller="YampiBarberShop"

                                       asp-action="ControlContacto">

                                        <i class="bi bi-telephone"></i>

                                        Control Contacto

                                    </a>

                                </li>

                            </ul>

                        </li>

                    }

                    <!-- OPCIONES DEL CLIENTE -->

                    @if (rol == "Cliente")

                    {

                        <li>

                            <a asp-controller="Citas"

                               asp-action="MisCitas">

                                <i class="bi bi-calendar-check"></i>

                                Mis Citas

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Citas"

                               asp-action="Crear">

                                <i class="bi bi-plus-lg"></i>

                                Agendar Cita

                            </a>

                        </li>

                    }

                    <!-- SALIR -->

                    <li>

                        <a asp-controller="Seguridad"

                           asp-action="Logout">

                            <i class="bi bi-box-arrow-right"></i>

                            Salir

                        </a>

                    </li>

                    <!-- PERFIL -->

                    <li>

                        <a asp-controller="Usuarios"

                           asp-action="Perfil"

                           title="Perfil">

                            <i class="bi bi-person"></i>

                        </a>

                    </li>

                }

            </ul>

        </nav>
        <div id="yampiMenuBackdrop" class="yampi-menu-backdrop" hidden></div>

        <!-- =================================================

             CONTENIDO

             IMPORTANTE:

             NO HAY .container AQUI

        ================================================== -->

        <section id="main">

            @RenderBody()

        </section>

    </div>

<!-- ==========================================

     FOOTER - YAMPI BARBERSHOP

\========================================== -->

<footer id="footer" class="yampi-footer">

    <div class="yampi-footer-container">

        <!-- CONTENIDO PRINCIPAL -->

        <div class="yampi-footer-grid">

            <!-- MARCA -->

            <div class="yampi-footer-brand">

                <div class="yampi-footer-logo">

                    <span class="yampi-footer-logo-icon">

                        <i class="bi bi-scissors"></i>

                    </span>

                    <div class="yampi-footer-logo-text">

                        <h2>YAMPI</h2>

                        <span>BARBER SHOP</span>

                    </div>

                </div>

                <p class="yampi-footer-description">

                    Tu estilo, nuestra pasion.

                    Un espacio dedicado al cuidado personal,

                    la buena atencion y los detalles

                    que marcan la diferencia.

                </p>

                <div class="yampi-footer-location">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span>

                        San Jose, Costa Rica

                    </span>

                </div>

            </div>

            <!-- CONTACTO -->

            <div class="yampi-footer-column">

                <h3>Contacto</h3>

                <div class="yampi-footer-heading-line"></div>

                <div class="yampi-footer-contact-list">

                    <!-- DIRECCION -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-geo-alt"></i>

                        </span>

                        <div>

                            <strong>Direccion</strong>

                            <p>

                                Avenida Central, 200 metros

                                norte del Parque Central,

                                San Jose, Costa Rica.

                            </p>

                        </div>

                    </div>

                    <!-- TELEFONO -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-telephone"></i>

                        </span>

                        <div>

                            <strong>Telefono</strong>

                            <a href="tel:+50622558888">

                                +506 2255-8888

                            </a>

                        </div>

                    </div>

                    <!-- WHATSAPP -->

                    <div class="yampi-footer-contact-item">

                        <span class="yampi-footer-contact-icon">

                            <i class="bi bi-whatsapp"></i>

                        </span>

                        <div>

                            <strong>WhatsApp</strong>

                            <!-- Agregar enlace real despues -->

                            <a href=""

                               target="_blank"

                               rel="noopener noreferrer">

                                +506 8888-9999

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <!-- HORARIOS -->

            <div class="yampi-footer-column">

                <h3>Horario de atencion</h3>

                <div class="yampi-footer-heading-line"></div>

                <p class="yampi-footer-hours-description">

                    Estamos para atenderte durante

                    la semana y los sabados.

                </p>

                <div class="yampi-footer-hours">

                    <div class="yampi-footer-hours-row">

                        <span>Lunes a Sabado</span>

                        <strong>

                            7:00 AM - 9:00 PM

                        </strong>

                    </div>


                </div>

                <div class="yampi-footer-hours-note">

                    <i class="bi bi-clock"></i>

                    <span>

                        Abiertos todos los dias para brindarte

                        la mejor atencion.

                    </span>

                </div>

            </div>

            <!-- REDES SOCIALES -->

            <div class="yampi-footer-column">

                <h3>Siguenos</h3>

                <div class="yampi-footer-heading-line"></div>

                <p class="yampi-footer-social-description">

                    Conecta con nosotros a traves

                    de nuestras redes sociales.

                </p>

                <div class="yampi-footer-social-list">

                    <!-- INSTAGRAM -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-instagram"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>Instagram</strong>

                            <small>

                                @@YampiBarberShop

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                    <!-- FACEBOOK -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-facebook"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>Facebook</strong>

                            <small>

                                Yampi BarberShopFB

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                    <!-- TIKTOK -->

                    <a href=""

                       target="_blank"

                       rel="noopener noreferrer"

                       class="yampi-footer-social-link">

                        <span class="yampi-footer-social-icon">

                            <i class="bi bi-tiktok"></i>

                        </span>

                        <span class="yampi-footer-social-info">

                            <strong>TikTok</strong>

                            <small>

                                @@YampiBarberShopCR

                            </small>

                        </span>

                        <i class="bi bi-arrow-up-right yampi-footer-social-arrow"></i>

                    </a>

                </div>

            </div>

        </div>

        <!-- SEPARADOR -->

        <div class="yampi-footer-divider"></div>

        <!-- PARTE INFERIOR -->

        <div class="yampi-footer-bottom">

            <div class="yampi-footer-copyright">

                <span>

                    &copy; @DateTime.Now.Year Yampi BarberShop.

                    Todos los derechos reservados.

                </span>

            </div>

            <div class="yampi-footer-bottom-right">

                <span>

                    <i class="bi bi-geo-alt"></i>

                    San Jose, Costa Rica

                </span>

                <span class="yampi-footer-bottom-separator"></span>

                <span class="yampi-footer-bottom-brand">

                    YAMPI BARBER SHOP

                </span>

            </div>

        </div>

    </div>

</footer>

    <!-- =====================================================

         SCRIPTS

    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/assets/js/jquery.min.js"></script>

    <script src="~/assets/js/jquery.dropotron.min.js"></script>

    <script src="~/assets/js/jquery.scrolly.min.js"></script>

    <script src="~/assets/js/browser.min.js"></script>

    <script src="~/assets/js/breakpoints.min.js"></script>

    <script src="~/assets/js/util.js"></script>

    
    <script src="~/js/layout-responsive.js" asp-append-version="true"></script>

</body>

</html>
