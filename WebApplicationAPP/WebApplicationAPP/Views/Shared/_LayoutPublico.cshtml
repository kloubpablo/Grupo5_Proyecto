@using WebApplicationAPP.Models
@using Microsoft.EntityFrameworkCore
@inject YampiBarbershopContext PublicDb
@{
    string? titulo = ViewData["Title"]?.ToString();
    var footerContacto = (ViewData.Model as InicioPublicoViewModel)?.Contacto
        ?? await PublicDb.Contactos.AsNoTracking().FirstOrDefaultAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090a" />
    <link rel="icon" type="image/png" href="~/assets/css/images/yampi.png" />
    <title>@(string.IsNullOrWhiteSpace(titulo) ? "Yampi BarberShop" : titulo + " - Yampi BarberShop")</title>

    <!-- Misma libreria de iconos utilizada por Citas y el layout administrativo -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-publico.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer-publico.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yampi-logo.css" asp-append-version="true" />
</head>
<body class="yp-body">
    <div id="page-wrapper">
        @await Html.PartialAsync("_YampiPublicNav")
        <div id="publicoMain">
            @RenderBody()
        </div>
        @await Html.PartialAsync("_YampiPublicFooter", footerContacto)
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/inicio-publico.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
