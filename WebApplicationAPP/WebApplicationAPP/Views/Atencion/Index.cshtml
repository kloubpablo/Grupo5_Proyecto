
@model List<WebApplicationAPP.Models.Atencion>
@using System.Linq

@{
    ViewData["Title"] = "Registro de Atencion";

    var atenciones = Model ?? new List<WebApplicationAPP.Models.Atencion>();
    var proximas = ViewBag.CitasAgenda as List<WebApplicationAPP.Models.Cita>
        ?? new List<WebApplicationAPP.Models.Cita>();
    bool admin = ViewBag.EsAdministrador is bool esAdmin && esAdmin;
    bool puedeAgregar = ViewBag.PuedeAgregar is bool b && b;
    bool puedeIniciar = ViewBag.PuedeIniciar is bool c && c;
    bool puedeRecibir = ViewBag.PuedeRecibir is bool d && d;
    bool puedeCobrar = ViewBag.PuedeCobrar is bool e && e;
    bool verHistorial = ViewBag.VerHistorial is bool h && h;
    bool puedeCancelarIngreso = ViewBag.PuedeCancelarIngreso is bool ci && ci;
    var barberos = ViewBag.Barberos as List<WebApplicationAPP.Models.Usuario>
        ?? new List<WebApplicationAPP.Models.Usuario>();
    DateOnly hoy = ViewBag.Hoy is DateOnly dh ? dh : DateOnly.FromDateTime(DateTime.Today);


    var activas = atenciones
        .Where(a => a.Estado == "En espera" || a.Estado == "En servicio")
        .OrderBy(a => a.Estado == "En servicio" ? 0 : 1)
        .ThenBy(a => a.IdAtencion)
        .ToList();

    var historial = atenciones
        .Where(a => a.Estado == "Finalizado" || a.Estado == "Cancelado")
        .OrderByDescending(a => a.IdAtencion)
        .ToList();

    int enEspera = activas.Count(a => a.Estado == "En espera");
    int enServicio = activas.Count(a => a.Estado == "En servicio");
    int totalActivos = activas.Count;
    int totalHistorial = historial.Count;
    int tiempoEstimado = enEspera * 10;
}

<link rel="stylesheet"
      href="~/css/atencion.css"
      asp-append-version="true" />


<div class="atencion-page">
    @if (TempData["ErrorAtencion"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorAtencion"]</div>
    }
    @if (TempData["ExitoAtencion"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["ExitoAtencion"]</div>
    }


    <!-- ENCABEZADO -->

    <header class="atencion-header">
        <div>
            <span class="atencion-kicker">GESTION DE SERVICIOS</span>

            <h1>
                <span class="atencion-title-icon">
                    <i class="bi bi-scissors"></i>
                </span>
                Registro de atencion
            </h1>

            <p>
                Administra los clientes en espera,
                los servicios activos y el historial.
            </p>
        </div>

        <div class="atencion-header-icon">
            <i class="bi bi-person-workspace"></i>
        </div>
    </header>

    <!-- ESTADISTICAS -->

    <div class="atencion-stats">

        <div class="atencion-stat-card">
            <div class="atencion-stat-icon">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <span>Clientes activos</span>
                <strong>@totalActivos</strong>
            </div>
        </div>

        <div class="atencion-stat-card">
            <div class="atencion-stat-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <span>En espera</span>
                <strong>@enEspera</strong>
            </div>
        </div>

        <div class="atencion-stat-card">
            <div class="atencion-stat-icon">
                <i class="bi bi-scissors"></i>
            </div>
            <div>
                <span>En servicio</span>
                <strong>@enServicio</strong>
            </div>
        </div>
    </div>

    <!-- INGRESOS PRESENCIALES -->
    @if (puedeAgregar)
    {
        <div class="atencion-toolbar">
            <button type="button" id="abrirCrearAtencion" class="atencion-btn-primary"
                    aria-controls="crearAtencionContainer" aria-expanded="false">
                <i class="bi bi-person-plus"></i>
                <span id="textoCrearAtencion">Cliente sin cita</span>
                <i class="bi bi-chevron-down atencion-chevron"></i>
            </button>
        </div>
        <div id="crearAtencionContainer" class="atencion-drawer closed">
            <section class="atencion-card">
                <div class="atencion-card-header">
                    <div>
                        <span class="atencion-card-kicker">INGRESO PRESENCIAL</span>
                        <h2><i class="bi bi-person-plus"></i> Reservar turno e ingresar cliente</h2>
                        <p>El horario se bloquea tambien para los clientes que reservan en la web.</p>
                    </div>
                </div>
                <form method="post" action="@Url.Action("Agregar", "Atencion")"
                      class="atencion-form" id="formIngresoPresencial"
                      data-ocupados-url="@Url.Action("HorariosOcupados", "Atencion")"
                      data-barbero-id="@ViewBag.MiBarberoId">
                    @Html.AntiForgeryToken()
                    <div class="atencion-field">
                        <label for="nombreCliente">Nombre del cliente</label>
                        <input type="text" id="nombreCliente" name="nombre" minlength="2"
                               maxlength="100" required placeholder="Nombre completo" />
                    </div>
                    <div class="atencion-field">
                        <label for="telefonoCliente">Telefono (opcional)</label>
                        <input type="tel" id="telefonoCliente" name="telefono" maxlength="20"
                               placeholder="Telefono" />
                    </div>
                    @if (admin)
                    {
                        <div class="atencion-field">
                            <label for="ingresoBarbero">Barbero responsable</label>
                            <select id="ingresoBarbero" name="idBarbero" required>
                                <option value="">Selecciona un barbero</option>
                                @foreach (var b in barberos)
                                {
                                    <option value="@b.IdUsuario">@b.Nombre (#@b.IdUsuario)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="atencion-field">
                        <label for="fechaIngreso">Fecha</label>
                        <input type="date" name="fecha" id="fechaIngreso"
                               min="@hoy.ToString("yyyy-MM-dd")" max="@hoy.ToString("yyyy-MM-dd")"
                               value="@hoy.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="atencion-field">
                        <label for="horaIngreso">Horario de 30 minutos</label>
                        <select name="hora" id="horaIngreso" required>
                            <option value="">Selecciona hora</option>
                            @for (int i = 0; i < 28; i++)
                            {
                                var slot = new TimeOnly(7, 0).AddMinutes(30 * i);
                                <option value="@slot.ToString("HH:mm")">@slot.ToString("HH:mm")</option>
                            }
                        </select>
                        <small>Solo se permiten turnos de hoy que no hayan terminado.</small>
                    </div>
                    <div class="atencion-form-actions">
                        <button type="button" id="cerrarCrearAtencion" class="atencion-btn-secondary">Cancelar</button>
                        <button type="submit" class="atencion-btn-primary"><i class="bi bi-check-lg"></i> Reservar e ingresar</button>
                    </div>
                </form>
            </section>
        </div>
    }

    <!-- AGENDA: LAS CITAS APARECEN SIN CREAR ATENCION AUTOMATICA -->
    <section class="atencion-card atencion-list-card">
        <div class="atencion-card-header">
            <div>
                <span class="atencion-card-kicker">AGENDA DEL BARBERO</span>
                <h2><i class="bi bi-calendar-check"></i> Reservas por recibir</h2>
                <p>Reservas online y administrativas. Registra la llegada para pasar a la lista de espera.</p>
            </div>
            <div class="atencion-count"><strong>@proximas.Count</strong><span>Reservas</span></div>
        </div>
        @if (proximas.Count == 0)
        {
            <div class="atencion-empty"><h3>No hay reservas futuras pendientes</h3></div>
        }
        else
        {
            <div class="atencion-table-wrapper">
                <table class="atencion-table">
                    <thead><tr>
                        <th>Cliente</th><th>Fecha</th><th>Hora</th>
                        @if (admin) { <th>Barbero</th> }
                        <th>Acciones</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var cita in proximas)
                    {
                        <tr>
                            <td><strong>@cita.IdClienteNavigation?.Nombre</strong></td>
                            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@cita.Hora.ToString("HH:mm")</td>
                            @if (admin) { <td>@cita.Barbero</td> }
                            <td>
                                @if (puedeRecibir && cita.Fecha == hoy)
                                {
                                    <form method="post" action="@Url.Action("RegistrarDesdeCita", "Atencion")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cita.IdCita" />
                                        <button type="submit" class="atencion-action-btn action-start">
                                            <i class="bi bi-box-arrow-in-right"></i> Registrar llegada
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="atencion-muted">@(cita.Fecha == hoy ? "Solo consulta" : "Proxima reserva")</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- LISTA DE ATENCION -->

    <section class="atencion-card atencion-list-card">

        <div class="atencion-card-header">
            <div>
                <span class="atencion-card-kicker">CONTROL DE ATENCION</span>

                <h2>
                    <i class="bi bi-list-ul"></i>
                    Lista de atencion
                </h2>

                <p>Clientes pendientes y actualmente en servicio.</p>
            </div>

            <div class="atencion-count">
                <strong>@totalActivos</strong>
                <span>Activos</span>
            </div>
        </div>

        @if (totalActivos == 0)
        {
            <div class="atencion-empty">
                <div class="atencion-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>No hay clientes en espera</h3>

                <p>
                    La lista de atencion esta vacia.
                    No existen clientes pendientes ni en servicio.
                </p>

                <span class="atencion-empty-status">
                    <i class="bi bi-check-circle"></i>
                    Lista actualizada
                </span>
            </div>
        }
        else
        {
            <div class="atencion-table-wrapper">
                <table class="atencion-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Cita</th>
                            <th>Estado</th>
                            <th>Hora inicio</th>
                            <th>Hora fin</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var a in activas)
                        {
                            var nombre = a.IdClienteNavigation?.Nombre
                                ?? "Cliente sin nombre";

                            <tr>
                                <td>
                                    <div class="atencion-client">
                                        <div class="atencion-avatar">
                                            @(string.IsNullOrWhiteSpace(nombre)
                                                ? "?"
                                                : nombre.Substring(0, 1).ToUpper())
                                        </div>
                                        <strong>@nombre</strong>
                                    </div>
                                </td>

                                <td>
                                    @if (a.IdCita != null)
                                    {
                                        <span class="atencion-cita">
                                            <i class="bi bi-calendar-check"></i>
                                            Cita #@a.IdCita
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="atencion-muted">Sin cita</span>
                                    }
                                </td>

                                <td>
                                    @if (a.Estado == "En espera")
                                    {
                                        <span class="atencion-status status-waiting">
                                            <span></span>
                                            En espera
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="atencion-status status-service">
                                            <span></span>
                                            Atendiendo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="atencion-time">
                                        <i class="bi bi-clock"></i>
                                        @(a.HoraInicio?.ToString("HH:mm") ?? "--")
                                    </span>
                                </td>

                                <td>
                                    <span class="atencion-time">
                                        <i class="bi bi-clock-history"></i>
                                        @(a.HoraFin?.ToString("HH:mm") ?? "--")
                                    </span>
                                </td>

                                <td>
                                    @if (a.Estado == "En espera")
                                    {
                                        @if (puedeIniciar)
                                        {
                                            <form method="post" action="@Url.Action("Iniciar", "Atencion")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.IdAtencion" />
                                                <button type="submit" class="atencion-action-btn action-start">
                                                    <i class="bi bi-play-fill"></i> Iniciar
                                                </button>
                                            </form>
                                        }
                                        @if (puedeCancelarIngreso)
                                        {
                                            <form method="post" action="@Url.Action("Cancelar", "Atencion")"
                                                  onsubmit="return confirm('¿Retirar el ingreso y liberar el horario?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.IdAtencion" />
                                                <button type="submit" class="atencion-action-btn action-finish">
                                                    <i class="bi bi-x-circle"></i> Retirar
                                                </button>
                                            </form>
                                        }
                                    }
                                    else if (a.Estado == "En servicio" && puedeCobrar)
                                    {
                                        <button type="button"
                                                class="atencion-action-btn action-finish btn-finalizar-pago"
                                                data-id="@a.IdAtencion"
                                                data-cliente="@nombre">
                                            <i class="bi bi-check2-circle"></i>
                                            Finalizar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (verHistorial)
    {
    <!-- BOTON HISTORIAL -->

    <div class="atencion-history-toolbar">
        <button type="button"
                id="abrirHistorialAtencion"
                class="atencion-btn-history"
                aria-controls="historialAtencionContainer"
                aria-expanded="false">

            <i class="bi bi-clock-history"></i>

            <span id="textoBotonHistorial">
                Ver historial de atencion
            </span>

            <span class="atencion-history-count">
                @totalHistorial
            </span>

            <i class="bi bi-chevron-down atencion-history-chevron"></i>
        </button>
    </div>

    <!-- GAVETA HISTORIAL -->

    <div id="historialAtencionContainer"
         class="atencion-drawer atencion-history-container closed">

        <section class="atencion-card atencion-history-card">

            <div class="atencion-card-header">
                <div>
                    <span class="atencion-card-kicker">REGISTROS ANTERIORES</span>

                    <h2>
                        <i class="bi bi-clock-history"></i>
                        Historial de atencion
                    </h2>

                    <p>Consulta servicios finalizados e ingresos retirados.</p>
                </div>

                <button type="button"
                        id="cerrarHistorialAtencion"
                        class="atencion-close-btn"
                        aria-label="Cerrar historial">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (totalHistorial == 0)
            {
                <div class="atencion-empty">
                    <div class="atencion-empty-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <h3>No hay historial de atencion</h3>
                    <p>Todavia no existen servicios finalizados registrados.</p>
                </div>
            }
            else
            {
                <div class="atencion-history-search">
                    <div class="atencion-search-input">
                        <i class="bi bi-search"></i>

                        <input type="search"
                               id="buscarHistorialAtencion"
                               placeholder="Buscar por cliente, cita o ID..."
                               autocomplete="off" />
                    </div>

                    <button type="button"
                            id="mostrarTodoHistorial"
                            class="atencion-btn-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Mostrar todos
                    </button>
                </div>

                <p id="historialAtencionResultados"
                   class="atencion-results-text">
                    @totalHistorial registros finalizados
                </p>

                <div class="atencion-table-wrapper">
                    <table class="atencion-table atencion-history-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Cita</th>
                                <th>Estado</th>
                                <th>Hora inicio</th>
                                <th>Hora fin</th>
                                <th>Registro</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var a in historial)
                            {
                                var nombre = a.IdClienteNavigation?.Nombre
                                    ?? "Cliente sin nombre";

                                <tr class="atencion-history-row"
                                    data-id="@a.IdAtencion"
                                    data-cliente="@nombre"
                                    data-cita="@(a.IdCita?.ToString() ?? "")">

                                    <td>
                                        <div class="atencion-client">
                                            <div class="atencion-avatar">
                                                @(string.IsNullOrWhiteSpace(nombre)
                                                    ? "?"
                                                    : nombre.Substring(0, 1).ToUpper())
                                            </div>
                                            <strong>@nombre</strong>
                                        </div>
                                    </td>

                                    <td>
                                        @if (a.IdCita != null)
                                        {
                                            <span class="atencion-cita">
                                                <i class="bi bi-calendar-check"></i>
                                                Cita #@a.IdCita
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="atencion-muted">Sin cita</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="atencion-status status-finished">
                                            <span></span>
                                            @a.Estado
                                        </span>
                                    </td>

                                    <td>
                                        <span class="atencion-time">
                                            <i class="bi bi-clock"></i>
                                            @(a.HoraInicio?.ToString("HH:mm") ?? "--")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="atencion-time">
                                            <i class="bi bi-clock-history"></i>
                                            @(a.HoraFin?.ToString("HH:mm") ?? "--")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="atencion-history-id">
                                            #@a.IdAtencion
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="historialAtencionSinResultados"
                         class="atencion-empty"
                         hidden>

                        <div class="atencion-empty-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <h3>No se encontraron resultados</h3>
                        <p>Prueba con otro nombre, numero de cita o ID.</p>
                    </div>
                </div>

                <div id="historialAtencionPaginacion"
                     class="atencion-history-pagination">

                    <button type="button"
                            id="historialAtencionAnterior"
                            class="atencion-page-btn">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div id="historialAtencionNumeros"
                         class="atencion-page-numbers"></div>

                    <button type="button"
                            id="historialAtencionSiguiente"
                            class="atencion-page-btn">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                <p id="historialAtencionResumen"
                   class="atencion-pagination-summary"></p>
            }
        </section>
    </div>

    }

    <!-- INFORMACION INFERIOR -->

    <div class="atencion-bottom-grid">

        <section class="atencion-card atencion-info-card">
            <div class="atencion-info-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <span class="atencion-info-label">
                TIEMPO ESTIMADO DE ESPERA
            </span>

            @if (enEspera == 0)
            {
                <h3 class="atencion-immediate">
                    Atencion inmediata disponible
                </h3>
                <p>No hay clientes en espera.</p>
            }
            else
            {
                <h3>@tiempoEstimado minutos</h3>
                <p>Estimacion de 10 minutos por cliente en espera.</p>
            }
        </section>

        <section class="atencion-card atencion-info-card">
            <div class="atencion-info-icon">
                <i class="bi bi-people"></i>
            </div>

            <span class="atencion-info-label">
                CLIENTES EN ATENCION
            </span>

            <h3>@totalActivos</h3>
            <p>@enEspera en espera y @enServicio en servicio.</p>
        </section>
    </div>
</div>

<!-- MODAL REGISTRAR PAGO -->

<div class="atencion-pago-overlay"
     id="registrarPagoModal"
     hidden>

    <div class="atencion-pago-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="pagoModalTitulo">

        <div class="atencion-pago-header">
            <div>
                <span class="atencion-pago-kicker">
                    FINALIZACION DEL SERVICIO
                </span>

                <h2 id="pagoModalTitulo">
                    <i class="bi bi-credit-card"></i>
                    Registrar pago
                </h2>

                <p>
                    Registra el pago para finalizar la atencion.
                </p>
            </div>

            <button type="button"
                    class="atencion-pago-close"
                    id="cerrarPagoModal"
                    aria-label="Cerrar ventana">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form id="formRegistrarPago"
            method="post"
            action="@Url.Action("RegistrarAjax", "Pagos")">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="pagoAtencionId"
                   name="idAtencion" />

            <div class="atencion-pago-field">
                <label for="pagoClienteVisible">
                    <i class="bi bi-person"></i>
                    Cliente
                </label>

                <input type="text"
                       id="pagoClienteVisible"
                       readonly />
            </div>

            <div class="atencion-pago-field">
                <label for="pagoMonto">
                    <i class="bi bi-cash-stack"></i>
                    Monto
                </label>

                <div class="atencion-pago-monto">
                    <span>₡</span>

                    <input type="number"
                           id="pagoMonto"
                           name="monto"
                           min="0.01"
                           step="0.01"
                           placeholder="0.00"
                           required />
                </div>
            </div>

            
            <div class="atencion-pago-field">
                <label id="pagoMetodoLabel">
                    <i class="bi bi-wallet2"></i>
                    Metodo de pago
                </label>

                <div class="atencion-custom-select"
                    id="pagoMetodoDropdown">

                    <input type="hidden"
                        id="pagoMetodo"
                        name="metodo"
                        value="" />

                    <button type="button"
                            id="pagoMetodoTrigger"
                            class="atencion-select-trigger"
                            aria-labelledby="pagoMetodoLabel pagoMetodoTexto"
                            aria-expanded="false"
                            aria-controls="pagoMetodoOpciones"
                            aria-haspopup="listbox">

                        <span class="atencion-select-content">
                            <i class="bi bi-wallet2"></i>

                            <span id="pagoMetodoTexto">
                                Seleccione un metodo
                            </span>
                        </span>

                        <i class="bi bi-chevron-down atencion-select-arrow"></i>
                    </button>

                    <div id="pagoMetodoOpciones"
                        class="atencion-select-options"
                        role="listbox"
                        aria-labelledby="pagoMetodoLabel">

                        <button type="button"
                                class="atencion-select-option"
                                role="option"
                                aria-selected="false"
                                data-value="Efectivo">

                            <span class="atencion-select-option-icon">
                                <i class="bi bi-cash-stack"></i>
                            </span>

                            <span>Efectivo</span>

                            <i class="bi bi-check-lg atencion-select-check"></i>
                        </button>

                        <button type="button"
                                class="atencion-select-option"
                                role="option"
                                aria-selected="false"
                                data-value="Tarjeta">

                            <span class="atencion-select-option-icon">
                                <i class="bi bi-credit-card"></i>
                            </span>

                            <span>Tarjeta</span>

                            <i class="bi bi-check-lg atencion-select-check"></i>
                        </button>
                    </div>
                </div>
            </div>


            <div class="atencion-pago-actions">
                <button type="button"
                        id="cancelarPagoModal"
                        class="atencion-pago-secondary">
                    Cancelar
                </button>

                <button type="submit"
                        id="guardarPagoBtn"
                        class="atencion-pago-primary">
                    <i class="bi bi-check-lg"></i>
                    Registrar pago
                </button>
            </div>
        </form>
    </div>
</div>

<div id="atencionPagoToast"
     class="atencion-pago-toast"
     role="status"
     aria-live="polite"
     hidden></div>

<script src="~/js/atencion.js"
        asp-append-version="true"></script>

