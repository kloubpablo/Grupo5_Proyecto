
@using System.Linq
@model IEnumerable<WebApplicationAPP.Models.Servicio>

@{
    ViewData["Title"] = "Control de Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var servicios = Model?.ToList()
        ?? new List<WebApplicationAPP.Models.Servicio>();
}

<link rel="stylesheet"
      href="~/css/control-servicio.css"
      asp-append-version="true" />

<div class="servicios-admin-page">

    <!-- ==========================================
         ENCABEZADO
    ========================================== -->

    <section class="servicios-page-header">

        <div>
            <span class="servicios-kicker">
                ADMINISTRACION / CONTROLES EXTERNOS
            </span>

            <h1>
                <span class="servicios-header-icon">
                    <i class="bi bi-scissors"></i>
                </span>

                Control de Servicios
            </h1>

            <p>
                Consulta y administra los servicios
                disponibles en Yampi BarberShop.
            </p>
        </div>

    </section>


    <!-- ==========================================
         RESUMEN
    ========================================== -->

    <section class="servicios-summary">

        <div class="servicios-summary-icon">
            <i class="bi bi-collection"></i>
        </div>

        <div>
            <span>Servicios registrados</span>
            <strong>@servicios.Count</strong>
        </div>

    </section>


    <!-- ==========================================
         LISTADO DE SERVICIOS
    ========================================== -->

    <section class="servicios-section">

        <div class="servicios-section-header">

            <div>
                <span class="servicios-kicker">
                    CATALOGO
                </span>

                <h2>
                    <i class="bi bi-grid-3x3-gap"></i>
                    Servicios registrados
                </h2>

                <p>
                    Informacion actual de los servicios
                    ofrecidos por la barberia.
                </p>
            </div>

            <span class="servicios-count">
                @servicios.Count servicios
            </span>

        </div>


        @if (!servicios.Any())
        {
            <!-- SIN SERVICIOS -->

            <div class="servicios-empty">

                <i class="bi bi-scissors"></i>

                <h3>No hay servicios registrados</h3>

                <p>
                    Actualmente no existen servicios
                    para mostrar.
                </p>

            </div>
        }
        else
        {
            <!-- TARJETAS -->

            <div class="servicios-grid">

                @foreach (var servicio in servicios)
                {
                    <article class="servicio-card">

                        <div class="servicio-card-header">

                            <div class="servicio-icon">
                                <i class="bi bi-scissors"></i>
                            </div>

                            <span class="servicio-label">
                                SERVICIO
                            </span>

                        </div>


                        <div class="servicio-card-body">

                            <h3>
                                @(string.IsNullOrWhiteSpace(servicio.Nombre)
                                    ? "Servicio sin nombre"
                                    : servicio.Nombre)
                            </h3>

                            <p>
                                @(string.IsNullOrWhiteSpace(servicio.Descripcion)
                                    ? "Sin descripcion registrada."
                                    : servicio.Descripcion)
                            </p>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>
