@using System.Linq
@model Contacto
@{
    ViewData["Title"] = "Editar Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">🖼️ Editar Contacto</h2>


@if (Model == null){
    <div class ="alert alert-warning">
        Hoy informacionde contacto registrada
        </div>
}else
{
    <form asp-controller="YampiBarberShop"
          asp-action="EditarContacto"
          method="post">
       <input type="hidden" name="id" value="@Model.Id" />
       
       <table class="table table-bordered table-hover">

           <thead class="table-dark">
               <tr>
                   <th>Campo</th>
                   <th>Informacion</th>
               </tr>
            </thead>

            <tbody>
                <tr>
                    <td><strong> Dirección</strong></td>
                    <td>
                        <input type="text"
                            name="direccion"
                            value="@Model.Direccion"
                            class="form-control" />
                    </td>
                    </tr>

                    <tr> 
                        <td><strong> Teléfonos</strong></td> 
                        <td> 
                            <input type="text" 
                                   name="telefonos" 
                                   value="@Model.Telefonos" 
                                   class="form-control" /> 
                        </td> 
                     </tr>

                     <tr> 
                         <td><strong> Horarios</strong></td> 
                         <td> 
                             <textarea name="horarios" 
                                 class="form-control" 
                                 rows="3">@Model.Horarios
                                 </textarea> 
                         </td> 
                     </tr>

                     <tr> 
                         <td><strong> WhatsApp</strong></td> 
                         <td> 
                             <input type="text" 
                                 name="whatsapp" 
                                 value="@Model.Whatsapp" 
                                 class="form-control" /> 
                         </td> 
                     </tr>

                     <tr> 
                         <td><strong> Instagram</strong></td> 
                         <td> 
                             <input type="text" 
                                    name="instagram" 
                                    value="@Model.Instagram" 
                                    class="form-control" /> 
                         </td> 
                         </tr>

                     <tr>
                         <td><strong> Facebook</strong></td> 
                         <td> 
                              <input type="text" 
                                     name="facebook" 
                                     value="@Model.Facebook" class="form-control" />
                         </td> 
                         </tr>

                     <tr> 
                         <td><strong> TikTok</strong></td>  
                         <td> 
                              <input type="text" 
                                     name="tiktok" 
                                     value="@Model.Tiktok" 
                                     class="form-control" /> 
                         </td>
                         </tr>

                     <tr> 
                         <td><strong> Ubicación</strong></td> 
                         <td>
                             <textarea name="ubicacion" 
                                       class="form-control" 
                                       rows="4">@Model.Ubicacion
                             </textarea> 
                        </td> 
                        </tr>


         </tbody> 
         
     </table>

     <div class="mt-3"> 
         <button type="submit" class="btn btn-primary">  
             Guardar cambios 
             </button> 
         </div>

</form>

}