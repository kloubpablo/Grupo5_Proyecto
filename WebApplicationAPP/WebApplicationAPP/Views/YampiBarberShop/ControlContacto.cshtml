@model WebApplicationAPP.Models.Contacto 
@{ ViewData["Title"] = "Control de Contacto"; 
Layout = "~/Views/Shared/_Layout.cshtml"; } 

<h2 class="mb-4">Información de Contacto
    </h2> @if (Model == null) 
    { 
        <div class="alert alert-warning"> 
            No hay información de contacto registrada. 
            </div> 
    } else 
    { 
        <div class="card"> 
            <div class="card-header"> 
                <h4>Información actual</h4>
                </div> 
                <div class="card-body"> 
                    <div class="mb-3"> 
                        <h5>Dirección</h5> 
                        <p>@Model.Direccion</p> 
                    </div> <div class="mb-3">
                        <h5>Teléfonos</h5>
                        <p>@Model.Telefonos</p>
                    </div> <div class="mb-3"> 
                        <h5>Correo electrónico</h5>
                        <p>@Model.Correo</p>
                    </div> <div class="mb-3"> 
                        <h5>Horarios</h5> 
                        <p>@Model.Horarios</p> 
                    </div> <div class="mb-3"> 
                        <h5>WhatsApp</h5> 
                        <p>@Model.Whatsapp</p> 
                    </div> <div class="mb-3"> 
                        <h5>Instagram</h5> 
                        <p>@Model.Instagram</p> 
                    </div> <div class="mb-3"> 
                        <h5>Facebook</h5> 
                        <p>@Model.Facebook</p> 
                    </div> <div class="mb-3">
                        <h5>TikTok</h5>
                        <p>@Model.Tiktok</p> 
                    </div> <div class="mb-3"> 
                        <h5>Ubicación</h5>
                        <div style="max-width: 500px;"> 
                            <iframe src="@Model.Ubicacion" 
                                    width="100%" height="250" 
                                    style="border:0;" 
                                    allowfullscreen="" 
                                    loading="lazy" 
                                    referrerpolicy="strict-origin-when-cross-origin"> 
                        </iframe>
                        </div>
                        </div> 
                        </div> 
                        <div class="card-footer"> 
                            <a asp-controller="YampiBarberShop" 
                               asp-action="EditarContacto" 
                               asp-route-id="@Model.Id" 
                               class="btn btn-primary"> 
                               Editar información 
                        </a> 
                        </div> 
                        </div> }