@model WebApplicationAPP.Models.Contacto
@{
    ViewData["Title"] = "Contáctenos";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<link rel="stylesheet" href="~/css/paginas-publicas.css" asp-append-version="true" />

<section class="contacto-section">

    <h1 class="titulo-principal">
        Contáctenos
    </h1>

    <p class="subtitulo">
        Estamos listos para atenderte. Ponte en contacto con nosotros o visítanos en nuestra barbería.
    </p>
     @if (Model == null)
    {
        <div class="alert alert-warning text-center">
            No hay información de contacto disponible.
        </div>
    }
    else
    {

        <div class="contacto-container">

            <!-- INFORMACIÓN -->
            <div class="info-card">

                <h3>Información de Contacto</h3>

                <div class="info-item">
                    <h5>📍 Dirección</h5>
                    <p>
                         @Model.Direccion
                    </p>
                </div>

                <div class="info-item">
                    <h5>📞 Teléfono Principal</h5>
                    <p>@Model.Telefonos</p>
                </div>

                <div class="info-item">
                    <h5>📱 WhatsApp</h5>
                    <p>@Model.Whatsapp</p>
                </div>

                <div class="info-item">
                    <h5>✉️ Correo Electrónico</h5>
                    <p>@Model.Correo</p>
                </div>

                <div class="info-item">
                    <h5>🕒 Horario</h5>
                    <p>@Model.Horarios</p>
                </div>

                <div class="info-item">
                    <h5>📸 Instagram</h5>
                    <a href="#">
                        @Model.Instagram
                    </a>
                </div>

                <div class="info-item">
                    <h5>📘 Facebook</h5>
                    <a href="#">
                        @Model.Facebook
                    </a>
                </div>

                <div class="info-item">
                    <h5>🎵 TikTok</h5>
                    <a href="#">
                        @Model.Tiktok
                    </a>
                </div>

            </div>

            <div class="mapa-card">

                <h3>Ubicación</h3>

                <div class="mapa-container">



                    <iframe src="@Model.Ubicacion" 
                    width="600" 
                    height="450" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="strict-origin-when-cross-origin">
                    </iframe>

                </div>

            </div>

        </div>
    }

</section>