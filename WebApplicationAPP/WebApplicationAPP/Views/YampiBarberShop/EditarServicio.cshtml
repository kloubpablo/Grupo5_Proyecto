@model WebApplicationAPP.Models.Servicio
@{
    ViewData["Title"] = "Editar Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4"> Control de Servicios</h2>

<form asp-action="EditarServicio" method="post">
    <input type="hidden" name="id"value="@Model.Id"/>
        <div class="mb-3">
            <label class="from-label">Nombre</label>
            <input
                type="text"
                name="nombre"
                class="form-control"
                value="@Model.Nombre"
                required
                />
        </div>
        <div class="mb-3">
            <label class="from-label">Precio</label>
            <input type="number"
                   name="precio"
                   class="form-control"
                   value="@Model.Precio"
                   required />
        </div>
        <div class="mb-3">
            <label class="from-label">Descripcion</label>
            <textarea
                   name="descripcion"
                   class="form-control"
                   rows="4"
                   required>
                   @Model.Descripcion</textarea>
        </div>
        <button type="submit" class="btn btn-success">
            Guardar
        </button>
        <a asp-action="ControlServicio" 
        class="btn btn-secondary">Cancelar
        </a>
</form>