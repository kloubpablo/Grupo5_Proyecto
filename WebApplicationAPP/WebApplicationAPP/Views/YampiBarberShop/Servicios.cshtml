@model IEnumerable<WebApplicationAPP.Models.Servicio>
@using System.Globalization

@{
    ViewData["Title"] = "Servicios";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";

    var servicios = Model?.ToList()
        ?? new List<WebApplicationAPP.Models.Servicio>();

    var culturaCR = CultureInfo.GetCultureInfo("es-CR");
}

<link rel="stylesheet" href="~/css/servicios-publico.css" asp-append-version="true" />

<div class="servicios-publico-page">

    <!-- ==========================================
         ENCABEZADO
    ========================================== -->

    <section class="servicios-publico-header">

        <div class="servicios-publico-header-content">

            <div class="servicios-publico-header-icon">
                <i class="bi bi-scissors"></i>
            </div>

            <h1>
                Nuestros <span>Servicios</span>
            </h1>

            <p>
                Conoce nuestros servicios de barberia,
                pensados para ofrecerte una atencion
                de calidad y un estilo que se adapte a ti.
            </p>

            <div class="servicios-publico-header-line"></div>

        </div>

    </section>

    <!-- ==========================================
         CATALOGO DE SERVICIOS
    ========================================== -->

    <section class="servicios-publico-section">

        <div class="servicios-publico-container">

            <div class="servicios-publico-section-header">

                <div>

                    <span class="servicios-publico-kicker">
                        CATALOGO DE SERVICIOS
                    </span>

                    <h2>
                        <i class="bi bi-grid-3x3-gap"></i>
                        Descubre lo que ofrecemos
                    </h2>

                    <p>
                        Explora nuestros servicios y encuentra
                        la opcion ideal para tu proxima visita.
                    </p>

                </div>

                <span class="servicios-publico-count">
                    <i class="bi bi-scissors"></i>
                    @servicios.Count servicios
                </span>

            </div>

            @if (!servicios.Any())
            {
                <!-- SIN SERVICIOS -->

                <div class="servicios-publico-empty">

                    <div class="servicios-publico-empty-icon">
                        <i class="bi bi-scissors"></i>
                    </div>

                    <h3>
                        Proximamente nuevos servicios
                    </h3>

                    <p>
                        Estamos preparando nuestro catalogo.
                        Vuelve pronto para conocer
                        todos nuestros servicios.
                    </p>

                </div>
            }
            else
            {
                <!-- TARJETAS -->

                <div class="servicios-publico-grid">

                    @foreach (var servicio in servicios)
                    {
                        <article class="servicios-publico-card">

                            <div class="servicios-publico-card-top">

                                <div class="servicios-publico-card-icon">
                                    <i class="bi bi-scissors"></i>
                                </div>

                                <span class="servicios-publico-card-label">
                                    SERVICIO
                                </span>

                            </div>

                            <div class="servicios-publico-card-body">

                                <h3>
                                    @(string.IsNullOrWhiteSpace(servicio.Nombre)
                                        ? "Servicio de barberia"
                                        : servicio.Nombre)
                                </h3>

                                <p>
                                    @(string.IsNullOrWhiteSpace(servicio.Descripcion)
                                        ? "Consulta con nuestro equipo para obtener mas informacion."
                                        : servicio.Descripcion)
                                </p>

                            </div>

                            <div class="servicios-publico-card-footer">

                                <div class="servicios-publico-price">

                                    <span>
                                        Precio del servicio
                                    </span>

                                    <strong>
                                        ₡@servicio.Precio.ToString("N2", culturaCR)
                                    </strong>

                                </div>

                                <span class="servicios-publico-card-decoration">
                                    <i class="bi bi-arrow-up-right"></i>
                                </span>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </section>

    <!-- ==========================================
         SECCION FINAL
    ========================================== -->

    <section class="servicios-publico-bottom">

        <div class="servicios-publico-bottom-content">

            <div class="servicios-publico-bottom-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <h2>
                ¿Listo para tu proximo corte?
            </h2>

            <p>
                Reserva tu cita y disfruta de nuestros
                servicios en Yampi BarberShop.
            </p>

            <a href="/Seguridad" class="servicios-publico-book-btn">

                <i class="bi bi-calendar-plus"></i>
                Reservar una cita
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>

</div>
